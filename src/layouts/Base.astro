---
// 書体: 見出し=明朝(Shippori Mincho)、本文=Zen Kaku Gothic New、欧文=EB Garamond(ローマン体)
import '@fontsource/zen-kaku-gothic-new/400.css';
import '@fontsource/zen-kaku-gothic-new/500.css';
import '@fontsource/zen-kaku-gothic-new/700.css';
import '@fontsource/shippori-mincho/500.css';
import '@fontsource/eb-garamond/400.css';
import '@fontsource/eb-garamond/500.css';

import { awards } from '../data/profile';
import { services } from '../data/services';
import { chapters } from '../data/chapters';

interface Props {
  title?: string;
  description?: string;
  /**
   * <title>を丸ごと指定する。検索対策で「職種+ブランド」の語順を作りたいページ用。
   * 指定しない場合は `${title} | YutanpopoZzz`。
   */
  fullTitle?: string;
  /** このページだけの構造化データ。共通の@graphに足される */
  jsonLd?: Record<string, unknown>[];
}
const { title, description, fullTitle, jsonLd: pageJsonLd = [] } = Astro.props;
// サイトの呼称(プロジェクト名)は「ゆたんぽぽーとふぉりお」だが、画面表示のブランドはYutanpopoZzz
const siteName = 'YutanpopoZzz';
const siteTagline = 'Virtual Photographer / Visual Creator';
// 検索対策: HOMEのタイトル・既定説明文に肩書きの表記ゆれ(和/英)を持たせる
const pageTitle =
  fullTitle ??
  (title
    ? `${title} | ${siteName}`
    : `バーチャルフォトグラファー ${siteName}（ゆたんぽぽ）| VRChat撮影・ビジュアル制作`);
const defaultDescription =
  'YutanpopoZzz(ゆたんぽぽ)は、VRChatを中心に活動するバーチャルフォトグラファー(VRフォトグラファー / VR Photographer)です。ポートレート・商品・イベントのプロモーション撮影、ビジュアル制作、イベント運営を行っています。';
const desc = description ?? defaultDescription;
// 公開URLの正は astro.config.mjs の site。ドメイン移行はそこ1箇所を直せば全部追従する
const siteUrl = Astro.site!.href.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = `${siteUrl}/og.jpg`;
const isHome = Astro.url.pathname === '/'; // ルート配信(base='/')前提
// 鮮度シグナル: ビルド日をdateModifiedとして構造化データに載せる
const buildDate = new Date().toISOString().slice(0, 10);

// 構造化データ: 人物(表記ゆれをalternateName/jobTitleで束ねる)+サイト
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteUrl}/#person`,
      name: 'YutanpopoZzz',
      // 表記ゆれを1エンティティに束ねる(検索・AI回答で別人扱いされないように)
      alternateName: ['ゆたんぽぽ', 'ゆたんぽぽZzz', 'yutanpopo', 'YutanPoPoZzz'],
      jobTitle: [
        'バーチャルフォトグラファー',
        'VRフォトグラファー',
        'Virtual Photographer',
        'VR Photographer',
        'Visual Creator',
      ],
      description:
        'VRChatを中心に活動するバーチャルフォトグラファー。ポートレート・商品・イベントのプロモーション撮影、ビジュアル制作、イベント運営を行う。',
      url: `${siteUrl}/`,
      image: `${siteUrl}/about/portrait.jpg`,
      sameAs: [
        'https://x.com/YutanpopoZzz',
        'https://note.com/popoz',
        'https://vrchat.com/home/user/usr_029b3b9d-63fc-4557-97d4-68cc176922ed',
        'https://github.com/YutanPoPoZzz',
      ],
      knowsAbout: [
        'VRChat',
        'VR写真',
        'バーチャルフォトグラフィー',
        'Virtual Photography',
        'メタバース',
        'アバター撮影',
        'バーチャル宣材写真',
        'ワールド撮影',
        'ライティング',
        'レタッチ',
      ],
      // E-E-A-T: 第三者評価を機械可読にする(AIの回答で「実績のある人物」として扱われる材料)
      award: awards.filter((a) => a.year !== '—').map((a) => a.title),
      hasOccupation: {
        '@type': 'Occupation',
        name: 'バーチャルフォトグラファー',
        alternateName: ['Virtual Photographer', 'VRフォトグラファー', 'VR Photographer'],
        description:
          'ゲームや仮想空間の中で、構図や光を選んで写真を撮る写真家。英語では Virtual Photography と呼ばれる。',
      },
      // 依頼検索の受け皿: 何を発注できるのかを構造化して並べる
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'VRChatでの撮影・ビジュアル制作',
        itemListElement: services.map((s) => ({
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: s.name,
            description: s.desc,
            serviceType: s.name,
            provider: { '@id': `${siteUrl}/#person` },
            areaServed: { '@type': 'VirtualLocation', name: 'VRChat' },
            url: `${siteUrl}/photography/#${s.slug}`,
          },
        })),
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      // 検索結果のサイト名になる。og:site_nameと完全一致させる。
      // 「Portfolio」のような一般語を足すとブランドとして認識されにくい
      name: 'YutanpopoZzz',
      alternateName: ['ゆたんぽぽ', 'ゆたんぽぽーとふぉりお', 'YutanpopoZzz Portfolio'],
      url: `${siteUrl}/`,
      inLanguage: 'ja',
      dateModified: buildDate,
      publisher: { '@id': `${siteUrl}/#person` },
    },
    ...pageJsonLd,
  ],
};
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// 目次 = 章立て(src/data/chapters.ts が正)。HOMEの目次と同じ番号を使う
const nav = chapters.map((c) => ({ n: c.n, jp: c.jp, href: `${base}${c.path}` }));
// 現在地の判定(HOMEは完全一致、他は配下ページも含む前方一致)
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === `${base}/` ? path === `${base}/` : path.startsWith(href);
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {/* Search Consoleの所有権確認。消すと確認が外れるので残すこと。
        トークンはプロパティごとに違うため、旧ドメインと新ドメインの2本を併記する。
        1本目: https://yutanpopozzz.github.io/ (旧・転送元として維持)
        2本目: https://yutanpopozzz.com/       (新・2026-08-11追加) */}
    <meta
      name="google-site-verification"
      content="8TQM-U1MtuAIn-3LffT0ulozDsF9-67uZMfh7KMZ0RM"
    />
    <meta
      name="google-site-verification"
      content="6oZgrZQYZw5Y6zXfBjYIXA9I2rTyvEVE8oEsjFTCrz8"
    />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={isHome ? 'profile' : 'website'} />
    {isHome && <meta property="profile:username" content="YutanpopoZzz" />}
    {/* 検索結果に出るサイト名。WebSiteのnameと1文字も違えないこと(揺れると
        Googleは外部の言及にフォールバックし、github.ioの親ブランド名を出す) */}
    <meta property="og:site_name" content="YutanpopoZzz" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@YutanpopoZzz" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {
      /* GitHub Pagesはレスポンスヘッダを設定できないためmeta CSPで代替。
         devではVite HMR(インラインscript/ws)が要るため本番ビルドのみ */
      import.meta.env.PROD && (
        <meta
          http-equiv="Content-Security-Policy"
          content="default-src 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com; font-src 'self'; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; object-src 'none'; base-uri 'self'; form-action 'none'"
        />
      )
    }
    {
      /* GA4(測定ID G-25QMLSF6S0)。開発中の閲覧を計測に混ぜないため本番ビルドのみ。
         設定コードは public/ga.js に出してある(CSPに'unsafe-inline'を足さずに済ませるため) */
      import.meta.env.PROD && <script is:inline src={`${base}/ga.js`} />
    }
    <link rel="icon" href={`${base}/favicon.png`} type="image/png" />
    {/* JSが動かない環境ではメニューを開けないので、畳まずそのまま並べる */}
    <noscript>
      <style>
        .nav-toggle, .nav-close, .nav-scrim { display: none !important; }
        .global-nav {
          position: static !important;
          width: auto !important;
          height: auto !important;
          visibility: visible !important;
          transform: none !important;
          background: none !important;
          border-left: none !important;
          box-shadow: none !important;
        }
        .global-nav ol { display: flex; flex-wrap: wrap; gap: 0 0.4rem; padding: 0.6rem 1.2rem; }
        .global-nav li + li { margin-top: 0; }
      </style>
    </noscript>
  </head>
  <body>
    {/* 柱(ランニングヘッド): 写真集の上端にある一行。左に書名、右に目次 */}
    <header class="site-header" data-header>
      <div class="header-in">
        <a class="logo" href={`${base}/`} aria-label={`${siteName} ホームへ`}>
          <img class="logo-mark" src={`${base}/icon.png`} alt="" width="34" height="34" />
          <span class="logo-name">{siteName}</span>
          <span class="logo-sub">写真集</span>
        </a>
        <button
          class="nav-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="global-nav"
          data-nav-toggle
        >
          目次
        </button>
      </div>
    </header>

    {/* 目次は header の外に置く(position:fixed の基準をずらさないため) */}
    <div class="nav-scrim" data-nav-scrim aria-hidden="true"></div>
    {/* リンクは常にHTMLに出したままにして、開閉はvisibilityで切り替える(クローラは全項目を読める) */}
    <nav class="global-nav" id="global-nav" aria-label="目次">
      <div class="nav-head">
        <p class="nav-title">目次</p>
        <button class="nav-close" type="button" data-nav-close>閉じる</button>
      </div>
      <ol>
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[{ active: isActive(item.href) }]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              <span class="n" aria-hidden="true">{item.n}</span>
              <span class="jp">{item.jp}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <slot />

    <footer class="site-footer">
      <div class="footer-inner">
        <p class="footer-logo">{siteName}</p>
        {/* 指名検索(「ゆたんぽぽ」)の受け皿。読み仮名は全ページの本文に1回は出しておく */}
        <p class="footer-role">ゆたんぽぽ ／ バーチャルフォトグラファー</p>
        <p class="footer-note">バーチャルの中に存在する文化や感情を、写真と言葉で外の世界へ運ぶ。</p>
        <p class="copyright">© 2026 YutanpopoZzz</p>
      </div>
    </footer>
    <script>
      // 目次の開閉。開いている状態は <html> の data-nav-open だけで表し、
      // 見た目(CSS)・背後のスクロール止め・aria-expanded をそこから引く。
      const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
      const closeBtn = document.querySelector<HTMLButtonElement>('[data-nav-close]');
      const scrim = document.querySelector<HTMLElement>('[data-nav-scrim]');
      const nav = document.getElementById('global-nav');
      const root = document.documentElement;

      if (toggle && closeBtn && scrim && nav) {
        const isOpen = () => root.hasAttribute('data-nav-open');

        const setOpen = (open: boolean) => {
          root.toggleAttribute('data-nav-open', open);
          toggle.setAttribute('aria-expanded', String(open));
          if (open) closeBtn.focus();
          else toggle.focus();
        };

        toggle.addEventListener('click', () => setOpen(!isOpen()));
        closeBtn.addEventListener('click', () => setOpen(false));
        scrim.addEventListener('click', () => setOpen(false));

        // 現在地のページへのリンクを踏んでも遷移しないことがあるので、明示的に閉じる
        nav.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).closest('a')) setOpen(false);
        });

        document.addEventListener('keydown', (e) => {
          if (e.key !== 'Escape' || !isOpen()) return;
          setOpen(false);
        });
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    /* 黒い台紙の写真集。色はこの4つ＋朱だけ */
    --board: #141210; /* 台紙(つや消しの温かい黒) */
    --board-2: #1b1916; /* 一段沈んだ面(写真の下敷き・入力欄など) */
    --ink: #ebe5d9; /* 紙白 */
    --pencil: #a59e92; /* 鉛。補足・キャプション */
    --rule: #3a352f; /* 罫 */
    --shu: #dc5638; /* 朱。検印(受付状況)と依頼の導線だけ。地とのコントラスト 4.83:1 */

    --font-jp: 'Zen Kaku Gothic New', 'Hiragino Kaku Gothic ProN', 'Yu Gothic', sans-serif;
    --font-mincho: 'EB Garamond', 'Shippori Mincho', 'Hiragino Mincho ProN', 'Yu Mincho', serif;
    --font-en: 'EB Garamond', var(--font-jp);

  }
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }
  html {
    scroll-behavior: smooth;
    color-scheme: dark;
    scrollbar-color: var(--rule) var(--board);
  }
  body {
    font-family: var(--font-jp);
    font-size: 16px;
    color: var(--ink);
    background: var(--board);
    line-height: 1.85;
    letter-spacing: 0.03em;
    -webkit-font-smoothing: antialiased;
    text-spacing-trim: trim-start;
    text-autospace: normal;
    font-kerning: normal;
    /* 和文を文節で折り返す(「記/録」のような語の途中割れを防ぐ。未対応ブラウザは通常の折り返し) */
    word-break: auto-phrase;
    /* 口絵の全面写真(100vw)でスクロールバー幅ぶん横にはみ出すのを切る(clipなのでstickyは壊れない) */
    overflow-x: clip;
  }
  ::selection {
    background: var(--ink);
    color: var(--board);
  }
  /* 明朝の見出しは仮名を詰める(既定の全角送りだと仮名がぱらついて「字間を広げた見出し」に見える) */
  h1,
  h2,
  h3,
  dt,
  .logo-sub,
  .nav-toggle,
  .nav-close,
  .global-nav .jp {
    font-feature-settings: 'palt';
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
  time,
  input,
  textarea {
    text-autospace: no-autospace;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  /* 依頼の導線は語句ごとに inline-block の span で包んでいる(語の途中で折り返さないため)。
     text-decoration は inline-block の中へは伝わらないので、span 側にも下線を引き継がせる */
  .colo-cta span,
  a.cta span,
  .channels a span {
    text-decoration: inherit;
    text-underline-offset: inherit;
  }
  a:focus-visible,
  button:focus-visible {
    outline: 1px solid var(--ink);
    outline-offset: 4px;
  }
  img {
    max-width: 100%;
    display: block;
  }
  /* WebP配信用の<picture>はレイアウトに出さない(imgが親の直下と同じ扱いになる) */
  picture {
    display: contents;
  }
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      transition: none !important;
      animation: none !important;
    }
  }

  /* ===== 柱 ===== */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 500;
    background: var(--board);
  }
  .header-in {
    padding: 0 clamp(1rem, 3vw, 2.4rem);
    height: 58px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .logo-mark {
    width: 34px;
    height: 34px;
    flex: none;
  }
  .logo-name {
    font-family: var(--font-en);
    font-size: 1.12rem;
    letter-spacing: 0.04em;
  }
  .logo-sub {
    font-family: var(--font-mincho);
    font-size: 0.82rem;
    color: var(--pencil);
    letter-spacing: 0.04em;
  }
  .nav-toggle,
  .nav-close {
    background: none;
    border: none;
    color: var(--ink);
    font-family: 'Shippori Mincho', serif;
    font-size: 0.95rem;
    letter-spacing: 0.1em;
    padding: 0.4rem 0;
    cursor: pointer;
    text-decoration: underline 1px transparent;
    text-underline-offset: 0.4em;
    transition: text-decoration-color 0.25s;
  }
  .nav-toggle:hover,
  .nav-close:hover {
    text-decoration-color: var(--ink);
  }

  /* ===== 目次(右からのパネル) ===== */
  .nav-scrim {
    position: fixed;
    inset: 0;
    z-index: 900;
    background: rgba(8, 7, 6, 0.7);
    visibility: hidden;
    opacity: 0;
    transition: opacity 0.3s ease, visibility 0s linear 0.3s;
  }
  :root[data-nav-open] .nav-scrim {
    visibility: visible;
    opacity: 1;
    transition: opacity 0.3s ease, visibility 0s;
  }
  .global-nav {
    position: fixed;
    top: 0;
    right: 0;
    z-index: 910;
    width: min(30rem, 100vw);
    height: 100dvh;
    display: flex;
    flex-direction: column;
    background: var(--board);
    padding: 0 clamp(1.4rem, 4vw, 2.6rem);
    transform: translateX(100%);
    visibility: hidden;
    transition: transform 0.42s cubic-bezier(0.16, 1, 0.3, 1), visibility 0s linear 0.42s;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  :root[data-nav-open] .global-nav {
    transform: none;
    visibility: visible;
    transition: transform 0.42s cubic-bezier(0.16, 1, 0.3, 1), visibility 0s;
  }
  :root[data-nav-open] {
    overflow: hidden;
  }
  .nav-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 58px;
    flex: none;
  }
  .nav-title {
    font-family: 'Shippori Mincho', serif;
    font-size: 0.95rem;
    color: var(--pencil);
  }
  .global-nav ol {
    list-style: none;
    margin-top: 2.2rem;
    padding-bottom: 3rem;
  }
  .global-nav a {
    display: grid;
    grid-template-columns: 2.6rem auto;
    align-items: baseline;
    gap: 0.6rem;
    padding: 0.75rem 0;
  }
  /* 奥付(お問い合わせ)だけ、ひと呼吸あけて離す */
  .global-nav li:last-child {
    margin-top: 1.4rem;
  }
  .global-nav .n {
    font-family: 'Shippori Mincho', serif;
    color: var(--pencil);
  }
  .global-nav .jp {
    font-family: 'Shippori Mincho', serif;
    font-size: 1.15rem;
    letter-spacing: 0.1em;
    word-break: keep-all;
  }
  .global-nav a:hover .jp {
    text-decoration: underline 1px;
    text-underline-offset: 0.35em;
  }
  /* 現在地: 頁の角を折るように、ノンブル欄に朱の点 */
  .global-nav a.active .n {
    color: var(--shu);
  }
  .global-nav li:last-child .jp {
    color: var(--ink);
  }
  @media (prefers-reduced-motion: reduce) {
    .global-nav,
    .nav-scrim {
      transition-duration: 0s;
    }
  }
  @media (max-width: 640px) {
    .logo-sub {
      display: none;
    }
  }

  /* blockttl: 章見出し。左寄せの明朝。英字の小ラベルは出さない */
  .blockttl {
    margin: 5rem 0 2.2rem;
  }
  .blockttl :is(h1, h2) {
    font-family: 'Shippori Mincho', serif;
    font-size: 1.2rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1.5;
  }

  .container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 clamp(1rem, 3vw, 2.4rem);
  }

  /* 巻末 */
  .site-footer {
    margin-top: 10rem;
  }
  .footer-inner {
    padding: 2.4rem clamp(1rem, 3vw, 2.4rem) 3rem;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.4rem 2rem;
    align-items: baseline;
