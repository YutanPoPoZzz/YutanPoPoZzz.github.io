---
// ブランドのページで、投稿ごとの写真を GALLERY と同じ並べ方(列幅を不揃いにし、
// いちばん短い列へ次を積む)で並べる。新しい投稿が左上から始まる
interface Post {
  url: string;
  label: string;
  iso: string;
  images: { src: string; aspect: number }[];
}
interface Props {
  posts: Post[];
  title: string;
}
const { posts, title } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="post-grid" data-post-masonry>
  {posts.map((p) => (
    <figure class="post">
      <a href={p.url} target="_blank" rel="noopener noreferrer">
        {p.images.map((im, i) => (
          <img
            src={`${base}${im.src}`}
            alt={`${title}の紹介写真(${p.label}${p.images.length > 1 ? `・${i + 1}枚目` : ''})`}
            width="1000"
            height={Math.round(1000 / im.aspect)}
            loading="lazy"
            decoding="async"
          />
        ))}
      </a>
      <figcaption><time datetime={p.iso}>{p.label}</time></figcaption>
    </figure>
  ))}
</div>

<script>
  function setup(grid: HTMLElement) {
    const items = Array.from(grid.querySelectorAll<HTMLElement>('.post'));
    let current = 0;
    const colCount = () => (window.innerWidth <= 560 ? 1 : window.innerWidth <= 900 ? 2 : 3);
    function layout() {
      const n = colCount();
      grid.classList.add('masonry');
      grid.textContent = '';
      const cols: HTMLElement[] = [];
      const heights: number[] = [];
      for (let i = 0; i < n; i++) {
        const c = document.createElement('div');
        c.className = 'post-col';
        c.style.flexGrow = String(n === 3 ? [5, 3, 4][i] : n === 2 ? [5, 4][i] : 1);
        grid.appendChild(c);
        cols.push(c);
        heights.push(0);
      }
      for (const item of items) {
        let best = 0;
        for (let i = 1; i < n; i++) if (heights[i] < heights[best]) best = i;
        cols[best].appendChild(item);
        // img に width/height があるので、読み込み前でも高さが確定している
        heights[best] += item.offsetHeight;
      }
      current = n;
    }
    layout();
    window.addEventListener('resize', () => {
      if (colCount() !== current) layout();
    });
  }
  document.querySelectorAll<HTMLElement>('[data-post-masonry]').forEach(setup);
</script>

<style>
  /* JS が動かないときは CSS の段組みで並べる */
  .post-grid { columns: 3; column-gap: 2.4rem; }
  .post-grid.masonry { columns: auto; display: flex; gap: 2.4rem; align-items: flex-start; }
  .post-grid :global(.post-col) { flex: 1 1 0; min-width: 0; }
  .post { break-inside: avoid; margin: 0 0 2.6rem; }
  .post a { display: block; text-decoration: none; }
  .post img { display: block; width: 100%; height: auto; transition: opacity 0.25s; }
  .post img + img { margin-top: 0.6rem; }
  .post a:hover img { opacity: 0.86; }
  .post figcaption { margin-top: 0.5rem; color: var(--pencil); font-size: 0.8rem; font-variant-numeric: tabular-nums; }
  @media (max-width: 900px) { .post-grid { columns: 2; } }
  @media (max-width: 560px) { .post-grid { columns: 1; } }
</style>
