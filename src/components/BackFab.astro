---
// スクロールしても消えない「戻る」ボタン(左下固定)
interface Props {
  href: string;
  label: string;
}
const { href, label } = Astro.props;
---

<a class="back-fab" href={href}>
  <span class="label">{label}</span>
</a>


<style>
.back-fab { position: fixed; left: 18px; top: 122px; z-index: 400; display: inline-block; padding: 0.6rem 1.2rem; background: var(--board); color: var(--ink); font-family: 'Shippori Mincho', serif; font-weight: 500; font-size: 0.95rem; text-decoration: underline 1px var(--pencil); text-underline-offset: 0.35em; }
  .back-fab:hover { text-decoration-color: var(--ink); }
  @media (max-width: 1200px) { .back-fab { top: auto; bottom: 18px; } }
  @media (max-width: 560px) { .back-fab { left: 12px; bottom: 12px; padding: 0.5rem 0.9rem; } }
</style>
