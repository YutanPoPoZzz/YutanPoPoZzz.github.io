---
// ページ左上に置く現在地パンくず(例: ワークス ／ minimaシリーズ)
interface Props {
  items: { label: string; href?: string }[];
}
const { items } = Astro.props;
---

<nav class="crumbs" aria-label="現在地">
  {items.map((it, i) => (
    <Fragment>
      {i > 0 && <span class="sep" aria-hidden="true">／</span>}
      {it.href ? <a href={it.href}>{it.label}</a> : <span class="cur">{it.label}</span>}
    </Fragment>
  ))}
</nav>


<style>
.crumbs { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem; margin: 2.2rem 0 1.2rem; font-size: 0.8rem; color: var(--pencil); }
  .crumbs a { text-decoration: underline 1px var(--pencil); text-underline-offset: 0.35em; }
  .crumbs a:hover { text-decoration-color: var(--ink); }
  .cur { color: var(--ink); }
</style>
