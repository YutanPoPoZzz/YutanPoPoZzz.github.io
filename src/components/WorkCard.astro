---
import type { CollectionEntry } from 'astro:content';
import { serviceColor } from '../data/services';

interface Props {
  work: CollectionEntry<'works'>;
}
const { work } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// タグ(=しごとの6項目)の色を差し色にする。該当なしはfrontmatterの色
const accent = serviceColor(work.data.category, work.data.color);
const d = work.data.date;
const dateLabel = `${d.getFullYear()}/${String(d.getMonth() + 1).padStart(2, '0')}/${String(d.getDate()).padStart(2, '0')}`;
---

<a class="entry-item" href={`${base}/works/${work.id}/`} style={`--c: ${accent}`}>
  <span class="entry-cat">{work.data.category}</span>
  {work.data.status && <span class="entry-status">{work.data.status}</span>}
  <figure class="entry-bg">
    <img src={`${base}${work.data.thumb}`} alt={work.data.title} loading="lazy" width="800" height="500" />
  </figure>
  <div class="entry-btm">
    <time class="entry-day" datetime={d.toISOString()}>{dateLabel}</time>
    <p class="entry-ttl">{work.data.title}</p>
  </div>
</a>

<style>
  /* カード構造 + hoverで作品色が発光する */
  .entry-item {
    position: relative;
    display: block;
    padding-top: 10px; /* 上辺に乗るチップのぶん */
  }
  .entry-cat {
    position: absolute;
    top: 0;
    left: 50%;
    translate: -50% 0;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    padding: 4px 13px;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    white-space: nowrap;
    color: var(--text);
    background: var(--bg-soft);
    border: 1px solid var(--line);
  }
  .entry-cat::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--c);
    transition: box-shadow 0.4s ease;
  }
  .entry-status {
    position: absolute;
    top: 22px;
    right: 10px;
    z-index: 1;
    padding: 1px 9px;
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    color: var(--text-weak);
    background: rgba(10, 10, 12, 0.7);
    border: 1px solid var(--line);
  }
  .entry-bg {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--bg);
    transition: box-shadow 0.4s ease, border-color 0.4s ease;
  }
  .entry-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .entry-btm {
    padding: 10px 0;
  }
  .entry-day {
    font-family: var(--font-en);
    font-weight: 300;
    font-size: 0.69rem;
    letter-spacing: 0.08em;
    color: var(--text-weak);
  }
  .entry-ttl {
    margin-top: 0.15rem;
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1.43;
    letter-spacing: 0.02em;
    transition: color 0.3s;
  }

  /* シグネチャ: hoverでその機体色が発光する */
  .entry-item:hover .entry-bg,
  .entry-item:focus-visible .entry-bg {
    box-shadow: 0 0 36px color-mix(in srgb, var(--c) 30%, transparent);
    border-color: color-mix(in srgb, var(--c) 45%, transparent);
  }
  .entry-item:hover .entry-cat::before {
    box-shadow: 0 0 10px var(--c);
  }
  .entry-item:hover .entry-bg img {
    transform: scale(1.03);
  }
  .entry-item:hover .entry-ttl {
    color: color-mix(in srgb, var(--c) 55%, white);
  }
  .entry-item:focus-visible {
    outline: 1px solid var(--text);
    outline-offset: 4px;
  }
</style>
