---
import type { CollectionEntry } from 'astro:content';
import { webpSrcset } from '../lib/img';

interface Props {
  work: CollectionEntry<'works'>;
}
const { work } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const d = work.data.date;
const dateLabel = `${d.getFullYear()}/${String(d.getMonth() + 1).padStart(2, '0')}/${String(d.getDate()).padStart(2, '0')}`;
---

<a class="entry-item" href={`${base}/works/${work.id}/`}>
  <figure class="entry-bg">
    <picture>
      {webpSrcset(work.data.thumb, base) && (
        <source
          type="image/webp"
          srcset={webpSrcset(work.data.thumb, base)}
          sizes="(max-width: 640px) 92vw, 256px"
        />
      )}
      <img
        src={`${base}${work.data.thumb}`}
        alt={work.data.title}
        loading="lazy"
        decoding="async"
        width="800"
        height="500"
      />
    </picture>
  </figure>
  <div class="entry-btm">
    <p class="entry-meta"><span>{work.data.category}</span>
    {work.data.status && <span>{work.data.status}</span>}
    <time class="entry-day" datetime={d.toISOString()}>{dateLabel}</time></p>
    <p class="entry-ttl">{work.data.title}</p>
  </div>
</a>


<style>
.entry-item { display: grid; grid-template-columns: 16rem minmax(0, 1fr); align-items: start; gap: 2.4rem; text-decoration: none; }
  .entry-bg { aspect-ratio: 3 / 2; }
  .entry-bg img { width: 100%; height: 100%; object-fit: cover; transition: opacity 0.25s; }
  .entry-item:hover img { opacity: 0.86; }
  .entry-meta { display: flex; flex-wrap: wrap; gap: 0.3rem 0.8rem; font-size: 0.82rem; color: var(--pencil); }
  .entry-ttl { margin-top: 0.6rem; font-family: 'Shippori Mincho', serif; font-weight: 500; font-size: 1.2rem; line-height: 1.7; letter-spacing: 0.04em; text-decoration: underline 1px var(--pencil); text-underline-offset: 0.35em; }
  .entry-item:hover .entry-ttl { text-decoration-color: var(--ink); }
  @media (max-width: 640px) { .entry-item { grid-template-columns: minmax(0, 1fr); gap: 0.8rem; } }
</style>
