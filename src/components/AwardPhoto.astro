---
import { getCollection } from 'astro:content';
import { awards } from '../data/profile';
import { webpSrcset, imgSize } from '../lib/img';

interface Props { size?: 'large' | 'medium'; }
const { size = 'medium' } = Astro.props;
const photo = (await getCollection('photos')).find((p) => p.data.thumb.includes('g-photocontest-4222aa30'));
const award = awards.find((a) => a.title.includes('第4回'));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = photo?.data.title.match(/『(.+?)』/)?.[1] ?? photo?.data.title;
---

{photo && award && (
  <div class:list={['award-photo', size]}>
    <figure>
      <picture>
        {webpSrcset(photo.data.thumb, base) && <source type="image/webp" srcset={webpSrcset(photo.data.thumb, base)} sizes={size === 'large' ? '(max-width: 760px) 94vw, 768px' : '(max-width: 560px) 94vw, 544px'} />}
        <img src={base + photo.data.thumb} alt={photo.data.title} {...imgSize(photo.data.thumb)} loading="lazy" decoding="async" />
      </picture>
      <figcaption><b>{title}</b><span>{award.title}　{award.year}</span></figcaption>
    </figure>
    <a class="award-link" href={base + '/about/'}>受賞歴をすべて見る</a>
  </div>
)}

<style>
  .award-photo { margin: 2rem 0 3rem; }
  img { display: block; width: auto; height: auto; max-width: 100%; max-height: min(60svh, 34rem); }
  .large img { max-height: min(80svh, 48rem); }
  figcaption { margin-top: 0.8rem; color: var(--pencil); font-size: 0.82rem; line-height: 1.8; }
  figcaption b { display: block; margin-bottom: 0.2rem; font-family: var(--font-mincho); font-size: 1rem; font-weight: 500; color: var(--ink); }
  .award-link { display: inline-block; margin-top: 1.5rem; font-size: 0.88rem; text-decoration: underline 1px var(--pencil); text-underline-offset: 0.35em; }
</style>
