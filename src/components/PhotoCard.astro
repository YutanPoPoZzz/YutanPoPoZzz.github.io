---
import type { CollectionEntry } from 'astro:content';
import { webpFull, webpSrcset } from '../lib/img';

interface Props {
  photo: CollectionEntry<'photos'>;
  aspect?: number;
  /** グリッドでの表示幅。既定はGALLERY/HOMEの3カラム想定 */
  sizes?: string;
  titleOnly?: boolean;
}
const {
  photo,
  aspect,
  sizes = '(max-width: 560px) 94vw, (max-width: 900px) 53vw, (max-width: 1180px) 40vw, 460px',
  titleOnly = false,
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// カードには小さい変種を配り、ライトボックスの原寸だけ data-full で別に渡す
const srcset = webpSrcset(photo.data.thumb, base);
const full = webpFull(photo.data.thumb, base) ?? `${base}${photo.data.thumb}`;
const catLabel: Record<string, string> = {
  portrait: 'ポートレート',
  commercial: '宣材・商品',
  event: 'イベント',
  photocontest: 'フォトコンテスト',
};
---

<figure
  class="photo-card"
  data-category={photo.data.category}
  data-aspect={aspect}
  data-title={photo.data.title}
  data-caption={`${catLabel[photo.data.category]}　${photo.data.date.getFullYear()}${photo.data.caption ? `　${photo.data.caption}` : ''}`}
  data-full={full}
>
  <div class="frame">
    <picture>
      {srcset && <source type="image/webp" srcset={srcset} sizes={sizes} />}
      <img
        src={`${base}${photo.data.thumb}`}
        alt={photo.data.title}
        loading="lazy"
        decoding="async"
        style={aspect ? `aspect-ratio: ${aspect}` : undefined}
      />
    </picture>
  </div>
  <figcaption>
    <b class="ttl">{titleOnly ? photo.data.title.match(/『(.+?)』/)?.[1] ?? photo.data.title : photo.data.title}</b>
    <span class="cat">{catLabel[photo.data.category]}　{photo.data.date.getFullYear()}</span>
  </figcaption>
</figure>


<style>
.photo-card { break-inside: avoid; margin: 0 0 2.4rem; }
  .frame img { width: 100%; height: auto; transition: opacity 0.25s; }
  .photo-card:hover .frame img { opacity: 0.86; }
  figcaption { margin-top: 0.6rem; font-size: 0.82rem; color: var(--pencil); line-height: 1.6; }
  .ttl { font-family: 'Shippori Mincho', serif; font-weight: 500; color: var(--ink); margin-right: 1em; font-size: 0.92rem; }
</style>
