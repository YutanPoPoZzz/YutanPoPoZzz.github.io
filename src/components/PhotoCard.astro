---
import type { CollectionEntry } from 'astro:content';

interface Props {
  photo: CollectionEntry<'photos'>;
  aspect?: number;
}
const { photo, aspect } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const catLabel: Record<string, string> = {
  portrait: 'PORTRAIT',
  commercial: 'COMMERCIAL',
  event: 'EVENT',
  photocontest: 'PHOTO CONTEST',
};
---

<figure
  class="photo-card"
  data-category={photo.data.category}
  data-aspect={aspect}
  data-title={photo.data.title}
  data-caption={photo.data.caption ?? ''}
>
  <div class="frame">
    <img
      src={`${base}${photo.data.thumb}`}
      alt={photo.data.title}
      loading="lazy"
      style={aspect ? `aspect-ratio: ${aspect}` : undefined}
    />
  </div>
  <figcaption>
    <span class="cat">{catLabel[photo.data.category]}</span>
    <span class="ttl">{photo.data.title}</span>
  </figcaption>
</figure>

<style>
  .photo-card {
    break-inside: avoid;
    margin: 0 0 26px;
  }
  .frame {
    border: 1px solid var(--line);
    overflow: hidden;
    transition: box-shadow 0.4s ease, border-color 0.4s ease;
  }
  .frame img {
    width: 100%;
    height: auto;
    transition: transform 0.4s ease;
  }
  .photo-card:hover .frame {
    border-color: rgba(255, 255, 255, 0.4);
    box-shadow: 0 0 32px rgba(255, 255, 255, 0.08);
  }
  .photo-card:hover .frame img {
    transform: scale(1.02);
  }
  figcaption {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    padding: 8px 2px 0;
  }
  .cat {
    font-family: var(--font-en);
    font-weight: 300;
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    color: var(--text-weak);
    white-space: nowrap;
  }
  .ttl {
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.04em;
  }
</style>
