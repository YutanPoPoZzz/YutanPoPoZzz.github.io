---
import '../../styles/book.css';
import '../../styles/lightbox.css';
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import EventLinks from '../../components/EventLinks.astro';
import BackFab from '../../components/BackFab.astro';
import { events, scaleNote } from '../../data/events';
import { webpFull, webpSrcset } from '../../lib/img';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const ev = events.find((e) => e.name === 'Roof Top Junction')!;
// 各回の告知ポスター(すべて自作)
const posters = [
  { slug: 'omohide', label: '思い出ボード' },
  { slug: 'vol6', label: 'vol.6' },
  { slug: 'vol5', label: 'vol.5' },
  { slug: 'vol4', label: 'vol.4' },
  { slug: 'vol3', label: 'vol.3' },
  { slug: 'vol2', label: 'vol.2' },
  { slug: 'vol1', label: 'vol.1' },
];
---

<Base
  title="Roof Top Junction"
  description="VRChatのDJイベント Roof Top Junction — 初心者でも音楽を楽しめる場づくりを軸にした、屋上の音楽イベント(主催)"
>
  <main class="container book-page rtj">
    <Crumbs items={[{ label: 'イベント運営', href: `${base}/events/` }, { label: ev.name }]} />

    <header class="head">
      <h1>{ev.name}</h1>
      <p class="genre">{ev.genre}・主催</p>
    </header>

    {ev.image && (
      <figure class="hero">
        <picture>
          {webpSrcset(ev.image, base) && (
            <source
              type="image/webp"
              srcset={webpSrcset(ev.image, base)}
              sizes="(max-width: 1180px) 94vw, 1104px"
            />
          )}
          <img src={`${base}${ev.image}`} alt={`${ev.name} キービジュアル`} decoding="async" />
        </picture>
      </figure>
    )}

    <section class="body">
      {ev.summary.map((p) => <p>{p}</p>)}
    </section>

    <section class="meta-block">
      <h2>イベント概要</h2>
      <dl class="meta">
        <div>
          <dt>主な役割</dt>
          <dd>{ev.roles}</dd>
        </div>
        <div>
          <dt>担当業務</dt>
          <dd>{ev.tasks}</dd>
        </div>
        <div>
          <dt>イベント規模</dt>
          <dd>
            {ev.scale.join(' ／ ')}
            <span class="scale-note">※ {scaleNote}</span>
          </dd>
        </div>
      </dl>
    </section>

    <div class="foot">
      <EventLinks links={ev.links} />
      {ev.credits && (
        <div class="credits">
          {ev.credits.map((c) => (
            <span>
              {c.role} :{' '}
              {c.url ? (
                <a href={c.url} target="_blank" rel="noopener noreferrer">{c.name}</a>
              ) : (
                c.name
              )}
            </span>
          ))}
        </div>
      )}
    </div>

    <section class="posters">
      <h2>ポスターアーカイブ</h2>
      <p class="posters-lead">
        各回の告知ポスターは自分で制作しています。写真・レイアウト・文字組みまで一貫して担当。
      </p>
      <div class="poster-grid">
        {posters.map((p) => (
          <button
            class="poster"
            type="button"
            data-poster={webpFull(`/events/rtj/${p.slug}.jpg`, base) ?? `${base}/events/rtj/${p.slug}.jpg`}
            data-label={p.label}
          >
            <picture>
              {webpSrcset(`/events/rtj/${p.slug}.jpg`, base) && (
                <source
                  type="image/webp"
                  srcset={webpSrcset(`/events/rtj/${p.slug}.jpg`, base)}
                  sizes="(max-width: 760px) 45vw, 400px"
                />
              )}
              <img
                src={`${base}/events/rtj/${p.slug}.jpg`}
                alt={`Roof Top Junction ${p.label} ポスター`}
                loading="lazy"
                decoding="async"
              />
            </picture>
            <span class="poster-label">{p.label}</span>
          </button>
        ))}
      </div>
    </section>

    <p class="back"><a href={`${base}/events/`}>イベント運営にもどる</a></p>
  </main>

  <BackFab href={`${base}/events/`} label="イベント運営" />

  <!-- ポスター拡大表示 -->
  <div class="lightbox" id="lightbox" hidden>
    <figure>
      <img id="lb-img" src="" alt="" draggable="false" />
      <figcaption>
        <span class="lb-title" id="lb-title"></span>
        <span class="lb-note">※ サイト掲載用にリサイズした画像です</span>
      </figcaption>
    </figure>
  </div>
</Base>

<script>
  const lightbox = document.getElementById('lightbox');
  const lbImg = document.getElementById('lb-img') as HTMLImageElement | null;
  const lbTitle = document.getElementById('lb-title');
  const grid = document.querySelector('.poster-grid');

  if (lightbox && lbImg && lbTitle && grid) {
    // 等倍だと拡大が強すぎたので原寸の半分まで。
    // ただし元が小さい画像だと拡大したことにならないので、最低1.5倍は効かせる
    const ZOOM_SCALE = 0.5;
    const MIN_ZOOM = 1.5;

    const unzoom = () => {
      lightbox.classList.remove('zoomed');
      lbImg.style.width = '';
      lightbox.scrollTo(0, 0);
    };

    const close = () => {
      lightbox.hidden = true;
      unzoom();
      lbImg.src = '';
      document.body.style.overflow = '';
    };

    grid.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('.poster');
      if (!btn?.dataset.poster) return;
      lbImg.src = btn.dataset.poster;
      lbImg.alt = `Roof Top Junction ${btn.dataset.label} ポスター`;
      lbTitle.textContent = `Roof Top Junction ${btn.dataset.label}`;
      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';
    });

    // 写真タップでズーム、もう一度で戻る。外側タップ/Escで閉じる
    lbImg.addEventListener('click', (e) => {
      e.stopPropagation();
      if (lightbox.classList.contains('zoomed')) {
        unzoom();
      } else {
        const r = lbImg.getBoundingClientRect();
        const rx = (e.clientX - r.left) / r.width;
        const ry = (e.clientY - r.top) / r.height;
        const iw = Math.min(
          lbImg.naturalWidth,
          Math.max(lbImg.naturalWidth * ZOOM_SCALE, r.width * MIN_ZOOM)
        );
        const ih = iw * (lbImg.naturalHeight / lbImg.naturalWidth);
        lbImg.style.width = `${iw}px`;
        lightbox.classList.add('zoomed');
        lightbox.scrollTo(
          iw * rx - lightbox.clientWidth / 2,
          ih * ry - lightbox.clientHeight / 2
        );
      }
    });
    lightbox.addEventListener('click', close);
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !lightbox.hidden) close();
    });
  }
</script>


<style>
.genre { display: block; color: var(--pencil); font-size: 0.85rem; margin-top: 0.5rem; }
  .meta { max-width: 48rem; margin-top: 2rem; }
  .meta > div { display: grid; grid-template-columns: 7em minmax(0, 1fr); gap: 1.4rem; padding: 0.5rem 0; }
  .meta dt { color: var(--pencil); font-size: 0.88rem; }
  .meta dd { max-width: 38em; }
  .scale-note { display: block; color: var(--pencil); font-size: 0.82rem; margin-top: 0.7rem; }
  .foot { margin-top: 2.4rem; }
  .credits { display: flex; flex-wrap: wrap; gap: 0.6rem 1.5rem; color: var(--pencil); font-size: 0.82rem; margin-top: 1.2rem; }
  @media (max-width: 560px) { .meta > div { grid-template-columns: 1fr; gap: 0.2rem; } }

  .head { margin-top: 3rem; }
  .head h1 { font-family: var(--font-en); }
  .hero { margin-top: 2rem; }
  .hero img { width: 100%; height: auto; }
  .body { margin-top: 2.4rem; }
  .body p { margin: 1.2rem 0; }
  .meta-block { margin-top: 6rem; }
  .posters { margin-top: 9rem; }
  .posters-lead { color: var(--pencil); margin-bottom: 2rem; }
  .poster-grid { display: grid; grid-template-columns: 1.2fr 0.9fr 1fr; align-items: start; gap: 3.4rem 2.4rem; }
  .poster { all: unset; display: block; min-width: 0; cursor: zoom-in; }
  .poster img { width: 100%; height: auto; transition: opacity 0.25s; }
  .poster:hover img { opacity: 0.86; }
  .poster:focus-visible { outline: 1px solid var(--ink); outline-offset: 4px; }
  .poster-label { display: block; margin-top: 0.6rem; font-family: 'Shippori Mincho', serif; font-weight: 500; font-size: 0.92rem; color: var(--ink); }
  @media (max-width: 760px) { .poster-grid { grid-template-columns: 1.1fr 1fr; gap: 2.4rem 1.2rem; } }
</style>
