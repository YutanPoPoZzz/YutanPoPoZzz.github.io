---
import '../styles/book.css';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import { minimaSeriesCard, SHOW_MINIMA } from '../data/minima-series-card';
import { workCategories } from '../data/work-categories';
import { services } from '../data/services';
import { webpSrcset } from '../lib/img';
import { periodOf } from '../lib/period';
import { photoAspect } from '../lib/photo-aspect';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const works = (await getCollection('works')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
// minima各機はシリーズカード1枠に集約するため一覧からは除外
const otherWorks = works.filter((w) => !w.id.startsWith('minima-'));

// 自作の配布物・ツールは「その他のつくりもの」へ回すカテゴリ
const MISC_CATEGORIES = ['VRChatギミック'];
const isMisc = (w: (typeof works)[number]) => MISC_CATEGORIES.includes(w.data.category);

// 制作実績: minimaと自作ツール、ブランドのPR撮影、その他の実績以外のすべて
const records = otherWorks.filter((w) => !isMisc(w) && !w.data.group);
// ブランドのPR撮影: ブランドごとに1行。件数と期間を添え、最新の投稿が新しいブランドから並べる
const prBrands = otherWorks
  .filter((w) => w.data.group === 'pr' && (w.data.posts?.length ?? 0) > 0)
  .map((w) => {
    const dates = (w.data.posts ?? []).map((p) => p.date);
    const { last, label } = periodOf(dates);
    return { w, count: dates.length, span: label, last };
  })
  .sort((a, b) => b.last.getTime() - a.last.getTime());
// ブランドの紹介撮影の看板写真(本人指定 2026-11-27)。写真の下にブランド名を添え、ブランドのページへ
// 投稿写真(幅750)では大きく出すと粗いため、原本から幅1200で書き出した看板用を使う
const prFeatureSpec = [
  { id: 'pr-diana', src: '/pr/feature/diana-1897044383792554357.jpg' },
  { id: 'pr-evostria', src: '/pr/feature/evostria-2090197123681685582.jpg' },
];
const prFeatures = await Promise.all(
  prFeatureSpec
    .map(({ id, src }) => ({ w: otherWorks.find((w) => w.id === id), src }))
    .filter((f): f is { w: (typeof works)[number]; src: string } => !!f.w)
    .map(async ({ w, src }) => ({ w, src, aspect: await photoAspect(src) }))
);
const otherRecords = otherWorks.filter((w) => w.data.group === 'other');
// その他: 自作ツール(新しい順)+minimaシリーズ
const misc = [...otherWorks.filter(isMisc), ...(SHOW_MINIMA ? [minimaSeriesCard] : [])];

---

<Base
  fullTitle="ポートフォリオ・制作実績 | バーチャルフォトグラファー YutanpopoZzz"
  description="バーチャルフォトグラファーYutanpopoZzzの制作実績。VRChatでのポートレート撮影、アバター・衣装の商品撮影、イベント記録、ポスターや告知ビジュアルの制作、執筆・登壇まで。受けられる6種類の依頼と作例をまとめています。"
>
  <main class="container book-page works">
    <div class="blockttl">
      <h1>ポートフォリオ</h1>
    </div>

    {/* ページ冒頭のプロフィール帯 */}
    <section class="profile">
      <img class="pf-icon" src={`${base}/icon.png`} alt="" width="150" height="150" />
      <div class="pf-body">
        <p class="pf-name">
          YutanpopoZzz
          <span class="pf-reading">ゆたんぽぽ</span>
          <span class="pf-roles">Virtual Photographer / Visual Creator</span>
        </p>
        <p class="pf-catch">「ここには人がいて、物語がある。」</p>
        <p class="pf-bio">
          <span>VRChatを中心に、3DモデルやVTuber、VRイベントのプロモーション撮影・ビジュアル制作を行っています。</span>
          <span>撮影の時間そのものと人の温度を大切に、瞬間ごとの空気を写真に残します。</span>
          <span>作家として、自分の世界観を形にする作品制作も。</span>
        </p>
        <p class="pf-link"><a href={`${base}/about/`}>くわしいプロフィールと実績</a></p>
      </div>
    </section>

    <!-- なにをしているのか: 3本柱 -->
    <section class="block">
      <h3>なにをしているのか</h3>
      <div class="pillars">
        {workCategories.map((cat) => (
          <div class="pillar" id={cat.slug}>
            {/* thumb 未設定のカテゴリは空フレームになる */}
            <span class="pillar-frame" aria-hidden="true">
              {cat.thumb && (
                <picture>
                  {webpSrcset(cat.thumb, base) && (
                    <source
                      type="image/webp"
                      srcset={webpSrcset(cat.thumb, base)}
                      sizes="(max-width: 760px) 92vw, 680px"
                    />
                  )}
                  <img src={`${base}${cat.thumb}`} alt="" loading="lazy" decoding="async" />
                </picture>
              )}
            </span>
            <p class="pillar-name">{cat.jp}</p>
            <p class="pillar-desc">{cat.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- しごとについて: 受けられる依頼 -->
    <section class="block">
      <h3>しごとについて</h3>
      <p class="sv-lead">
        依頼できる内容・納品までの流れ・料金の考え方は
        <a href={`${base}/photography/`}>撮影依頼ガイド</a>にまとめています。
      </p>
      <ul class="services">
        {services.map((s) => (
          <li>
            <a href={`${base}/works/tag/${s.slug}/`}>
              <span class="sv-title">{s.name}</span>
              <span class="sv-desc">{s.desc}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- 制作実績(まだ空。作品mdを置くとここに並ぶ) -->
    <section class="block" id="records">
      <h3>制作実績</h3>
      {records.length > 0 ? (
        <div class="grid">
          {records.map((w) => <WorkCard work={w} />)}
        </div>
      ) : (
        <p class="empty">実績ページを準備中です。順次追加していきます。</p>
      )}
    </section>

    <!-- ブランドの紹介撮影: ブランドごとのページへ -->
    {prBrands.length > 0 && (
      <section class="block" id="pr">
        <h3>ブランドの紹介撮影</h3>
        <p class="pr-lead">アバター・衣装・靴のブランドの新作を、Xの紹介投稿用に撮った写真です。</p>
        {prFeatures.length > 0 && (
          <div class="pr-feature">
            {prFeatures.map(({ w, src, aspect }) => (
              <figure>
                <a href={`${base}/works/${w.id}/`} tabindex="-1" aria-hidden="true">
                  <img
                    src={`${base}${src}`}
                    alt={`${w.data.title}の紹介写真`}
                    width="1000"
                    height={Math.round(1000 / aspect)}
                    loading="lazy"
                    decoding="async"
                  />
                </a>
                <figcaption><a href={`${base}/works/${w.id}/`}>{w.data.title}</a></figcaption>
              </figure>
            ))}
          </div>
        )}
        <ul class="pr-brands">
          {prBrands.map(({ w, count, span }) => (
            <li>
              <a href={`${base}/works/${w.id}/`}>{w.data.title}</a>
              <span class="pr-meta">{count}件・{span}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- その他の実績 -->
    {otherRecords.length > 0 && (
      <section class="block" id="other-records">
        <h3>その他の実績</h3>
        <div class="grid">
          {otherRecords.map((w) => <WorkCard work={w} />)}
        </div>
      </section>
    )}

    <!-- その他のつくりもの -->
    <section class="block" id="others">
      <h3>その他のつくりもの</h3>
      <div class="grid">
        {misc.map((w) => <WorkCard work={w} />)}
      </div>
    </section>

    <!-- 依頼CTA -->
    <a class="cta" href={`${base}/contact/`}>
      <span style="display:inline-block">お仕事のご依頼・</span><span style="display:inline-block">ご相談はこちら</span>
    </a>
  </main>
</Base>


<style>
.profile { display: flex; align-items: start; gap: 2rem; max-width: 52rem; }
  .pf-icon { width: 150px; height: 150px; flex: none; }
  .pf-name { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.3rem 1rem; font-family: var(--font-en); font-size: 1.5rem; }
  .pf-reading { font-family: var(--font-jp); font-size: 0.85rem; color: var(--pencil); }
  .pf-roles { flex-basis: 100%; font-size: 1rem; color: var(--pencil); }
  .pf-catch { font-family: 'Shippori Mincho', serif; font-size: 1.3rem; margin-top: 1.3rem; }
  .pf-bio { margin-top: 0.8rem; font-size: 0.92rem; }
  .pf-bio span { display: block; }
  .pf-link { margin-top: 1rem; font-size: 0.88rem; }
  .pillars { display: grid; grid-template-columns: 7fr 4fr; gap: 2.4rem clamp(2rem, 5vw, 4.4rem); align-items: start; }
  .pillar:nth-child(2) { margin-top: 5rem; }
  .pillar:nth-child(n+3) { grid-column: 2; }
  .pillar-frame { display: block; }
  .pillar-frame img { width: 100%; height: auto; margin-bottom: 0.6rem; }
  .pillar-name, .sv-title { font-family: 'Shippori Mincho', serif; font-size: 1.2rem; font-weight: 500; }
  .pillar-desc, .sv-desc { color: var(--pencil); font-size: 0.9rem; margin-top: 0.35rem; }
  .sv-lead { color: var(--pencil); }
  .services { list-style: none; max-width: 48rem; margin-top: 2rem; }
  .services li + li { margin-top: 2.2rem; }
  .services a { display: block; text-decoration: none; }
  .sv-title { text-decoration: underline 1px var(--pencil); text-underline-offset: 0.35em; }
  .services a:hover .sv-title { text-decoration-color: var(--ink); }
  .sv-desc { display: block; max-width: 38em; }
  .pr-lead { color: var(--pencil); }
  /* 看板写真: 活動3本柱と同じく大小の差をつけ、右を少し下げる。スマホでも2列のまま */
  .pr-feature { display: grid; grid-template-columns: 6fr 5fr; gap: clamp(1rem, 4vw, 3.4rem); align-items: start; max-width: 56rem; margin-top: 2.6rem; }
  .pr-feature figure { margin: 0; }
  .pr-feature figure:nth-child(2) { margin-top: clamp(2rem, 8vw, 6rem); }
  .pr-feature img { display: block; width: 100%; height: auto; }
  .pr-feature figcaption { margin-top: 0.6rem; font-family: var(--font-mincho); font-weight: 500; font-size: 1.05rem; }
  /* 左から右へ読んだときに新しい順になるよう、段組みでなくグリッドで並べる */
  .pr-brands { list-style: none; padding: 0; margin-top: 2rem; display: grid; grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr)); column-gap: 4rem; max-width: 48rem; }
  .pr-brands li { display: flex; flex-wrap: wrap; align-items: baseline; column-gap: 0.9em; padding: 0.45rem 0; }
  .pr-brands a { font-family: var(--font-mincho); font-weight: 500; font-size: 1.1rem; }
  .pr-meta { color: var(--pencil); font-size: 0.8rem; font-variant-numeric: tabular-nums; }
  @media (max-width: 760px) { .profile { flex-direction: column; } .pillars { grid-template-columns: 1fr; } .pillar:nth-child(2) { margin-top: 2rem; max-width: 85%; } .pillar:nth-child(n+3) { grid-column: 1; margin-top: 1rem; } }
</style>
