---
import Base from '../layouts/Base.astro';
import { availability } from '../data/profile';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const items = [
  'お名前（活動名）',
  'ご連絡先（XのDM / メールアドレス）',
  '依頼内容（ポートレート / 商品撮影 / イベント撮影 / ビジュアル制作 など）',
  '希望納期',
  '使用目的・掲載先',
  '商用利用の有無',
  '希望する写真の枚数',
  'ご予算',
  '参考資料（イメージに近い写真やワールドなど）',
];

// メールリンク: 宛先・件名・依頼フォーマット入りの本文を最初から入れておく
const MAIL_TO = 'yutanpopozch@gmail.com';
const mailSubject = '撮影・ビジュアル制作のご依頼／ご相談';
const mailBody = [
  'YutanpopoZzz さま',
  '',
  '撮影（ビジュアル制作）についてご相談させてください。',
  '',
  '─────────────',
  ...items.map((item) => `${item.replace(/（.*）$/, '')}：`),
  '─────────────',
  '',
  '（ご自由にご記入ください）',
  '',
].join('\n');
const mailHref = `mailto:${MAIL_TO}?subject=${encodeURIComponent(mailSubject)}&body=${encodeURIComponent(mailBody)}`;
---

<Base
  fullTitle="撮影・ビジュアル制作のご依頼 | バーチャルフォトグラファー YutanpopoZzz"
  description="VRChatでのポートレート撮影、アバター・衣装の宣材写真、イベント記録、告知ビジュアル制作のご依頼窓口です。XのDMまたはメールから受け付けています。料金は内容を伺ったうえで個別にお見積もりします。ご相談だけでも歓迎です。"
>
  <main class="container contact">
    <div class="blockttl">
      <h2>ご依頼・お問い合わせ</h2>
      <span class="sub">CONTACT</span>
    </div>
    <div class="body">
      {/* 語の途中で折り返さないよう、日付と本文をそれぞれ nowrap で包む */}
      <p class="status" data-open={availability.open ? '' : undefined}>
        <span class="dot" aria-hidden="true"></span>
        <span class="status-txt"
          ><b class="nb">{availability.asOf}現在</b><span class="nb"> — {availability.text}</span></span
        >
      </p>
      <p>
        VRChatでのポートレート撮影、アバター・衣装・商品のプロモーション撮影、イベント記録、
        ポスターやSNS告知などのビジュアル制作のご依頼を受け付けています。
        ご相談だけでも大丈夫ですので、遠慮なくご連絡ください。
      </p>
      <p class="guide-link">
        はじめての方は <a href={`${base}/photography/`}>撮影依頼ガイド</a>
        に、依頼できる内容・納品までの流れ・よくある質問をまとめています。
      </p>
      <div class="notes">
        <h3>料金について</h3>
        <p class="lead">
          撮影時間・納品枚数・レタッチの度合い・使用範囲によって変わるため、
          ご依頼の内容を伺ったうえでお見積りをお出しします。
          ご予算がお決まりの場合は、その範囲でできることをご提案しますので、
          金額感からのご相談でも遠慮なくお知らせください。
        </p>
      </div>

      <p>
        ご依頼の際は、以下の項目を添えていただけると、確認のやり取りが少なくスムーズです。
      </p>
      <ol class="items">
        {items.map((item) => <li>{item}</li>)}
      </ol>

      <div class="channels">
        <a href="https://x.com/YutanpopoZzz" target="_blank" rel="noopener noreferrer">X のDMで相談する ↗</a>
        <a href={mailHref}>メールで相談する ↗</a>
      </div>

      <div class="notes">
        <h3>ご相談のうえ進めたいこと</h3>
        <p class="lead">
          次のようなご依頼は、私ひとりでは責任を持ちきれない部分があります。
          お断りするという意味ではなく、進め方を一緒に決めさせてください。
        </p>
        <ul>
          <li>性的・過激な表現を含む撮影</li>
          <li>ワールド・アバター・アセットの利用規約や権利関係が確認できない案件</li>
        </ul>
      </div>

      <div class="notes">
        <h3>ご依頼にあたって</h3>
        <ul>
          <li>写真の使用範囲・クレジット表記は事前にご相談のうえ取り決めます</li>
          <li>商用利用はご相談ください</li>
          <li>撮影に使用するVRChatワールドやアセットの利用規約は、双方で確認のうえ進めます</li>
          <li>修正回数・納期の目安は依頼内容に応じてお見積もりします</li>
        </ul>
      </div>
    </div>
  </main>
</Base>

<style>
  .contact {
    max-width: 640px;
  }
  .body {
    font-size: 0.92rem;
  }
  .body p {
    margin: 1rem 0;
  }
  /* 受付状況: 依頼の入口なのでCTA系(lagoon配色)の青を灯す。金(ナビ)とは別系統 */
  .status {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 1.6rem;
    padding: 0.62rem 0.95rem;
    border: 1px solid var(--line);
    font-size: 0.85rem;
    line-height: 1.6;
  }
  .status b {
    font-weight: 600;
  }
  .status .nb {
    white-space: nowrap;
  }
  .status .dot {
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--text-weak);
  }
  .status[data-open] {
    border-color: color-mix(in srgb, var(--cta-blue) 34%, transparent);
  }
  .status[data-open] .dot {
    background: var(--cta-blue);
    box-shadow: 0 0 10px color-mix(in srgb, var(--cta-blue) 70%, transparent);
    animation: status-pulse 2.8s ease-in-out infinite;
  }
  @keyframes status-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .status[data-open] .dot {
      animation: none;
    }
  }
  .guide-link {
    font-size: 0.85rem;
    color: var(--text-weak);
  }
  .guide-link a {
    color: var(--text);
    border-bottom: 1px solid var(--line);
    transition: border-color 0.3s;
  }
  .guide-link a:hover {
    border-color: var(--text);
  }
  .items {
    margin: 1.4rem 0;
    padding-left: 1.6rem;
  }
  .items li {
    margin: 0.4rem 0;
    font-size: 0.88rem;
  }
  .channels {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin: 2.2rem 0;
  }
  .channels a {
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    border: 1px solid var(--line);
    padding: 0.55rem 1.4rem;
    transition: border-color 0.3s, box-shadow 0.3s;
  }
  .channels a:hover {
    border-color: rgba(255, 255, 255, 0.5);
    box-shadow: 0 0 18px rgba(255, 255, 255, 0.08);
  }
  .notes {
    border-top: 1px solid var(--line);
    padding-top: 1.6rem;
    margin-top: 2rem;
  }
  .notes h3 {
    font-size: 0.95rem;
    letter-spacing: 0.14em;
    margin-bottom: 0.6rem;
  }
  .notes .lead {
    margin: 0.6rem 0 0;
    font-size: 0.85rem;
    line-height: 1.9;
    color: var(--text-weak);
  }
  .notes .lead + ul {
    margin-top: 0.9rem;
  }
  .notes ul {
    padding-left: 1.4rem;
  }
  .notes li {
    margin: 0.35rem 0;
    font-size: 0.85rem;
    color: var(--text-weak);
  }
  .note {
    margin-top: 2.4rem;
    font-size: 0.74rem;
    color: var(--text-weak);
  }
</style>
