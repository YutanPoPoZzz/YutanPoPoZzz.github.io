---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { availability } from '../data/profile';
import { events } from '../data/events';
import { webpSrcset, imgSize } from '../lib/img';
import { chapters } from '../data/chapters';

// HOME = 写真集の「表紙と目次」だけ。1画面で完結させ、中身は各章(各ページ)に任せる。
// 下へ長く読ませる抜粋(口絵・仕事・イベント・受賞)は置かない。
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const photos = (await getCollection('photos')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const works = await getCollection('works');
const publicWorks = works.filter((w) => !w.id.startsWith('minima-'));

// 表紙の写真(本人指定・2026-11-18)。ギャラリーの写真とは別に public/cover/ に置く。
// 差し替えるときは public/cover/ に入れて gen-webp を回し、ここのパスと比率を直す
const cover = {
  src: '/cover/top-2026-10-30.jpg',
  alt: '窓辺に座る、黒い猫耳のアバターのモノクロのポートレート',
  aspect: 9 / 16,
};

// 目次: 章立ては chapters.ts が正。件数はデータから数える
const tocCount: Record<string, string | undefined> = {
  '/gallery/': `${photos.length}点`,
  '/works/': `${publicWorks.length}件`,
  '/events/': `${events.length}件`,
  '/contact/': availability.open ? availability.short : undefined,
};
const toc = chapters.filter((c) => c.path !== '/');
---

<Base>
  <main class="cover">
    <figure class="cover-photo" style={`aspect-ratio:${cover.aspect}`}>
      <a href={`${base}/gallery/`}>
        <picture>
          {webpSrcset(cover.src, base) && (
            <source
              type="image/webp"
              srcset={webpSrcset(cover.src, base)}
              sizes="(max-width: 640px) 60vw, 50svh"
            />
          )}
          <img
            src={`${base}${cover.src}`}
            alt={cover.alt}
            {...imgSize(cover.src)}
            fetchpriority="high"
          />
        </picture>
      </a>
    </figure>

    <div class="spine">
      <p class="cover-copy">
        バーチャルの中に存在する<br />文化や感情を、写真と言葉で<br />外の世界へ運ぶ。
      </p>
      {/* h1に読み仮名と和文の肩書きを持たせる(指名検索・職種検索の受け皿) */}
      <h1 class="cover-title">
        <span class="t-name">YutanpopoZzz</span>
        <span class="t-kana">ゆたんぽぽ</span>
        <span class="t-role">バーチャルフォトグラファー</span>
      </h1>
    </div>

    <nav class="toc" aria-label="このサイトの目次">
      <h2 class="toc-ttl">目次</h2>
      <ol>
        {toc.map((c) => (
          <li class:list={[{ last: c.path === '/contact/' }]}>
            <a href={`${base}${c.path}`}>
              <span class="toc-n">{c.n}</span>
              <span class="toc-t">{c.jp}</span>
              <span class="toc-c">{tocCount[c.path] ?? ''}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </main>
</Base>

<style>
  /* トップは1画面で完結させるので、巻末はここでは出さない(全ページ共通の巻末は各章にある) */
  :global(.site-footer) {
    display: none;
  }

  /* ===== 表紙＋目次: 縦長の写真を画面の高さいっぱいに立て、その脇に縦組みの帯、
     右下に目次。写真と帯は左に寄せ、真ん中は余白として空けておく ===== */
  .cover {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr) clamp(15rem, 20vw, 19rem);
    grid-template-rows: minmax(0, 1fr);
    grid-template-areas: 'photo spine . toc';
    gap: clamp(1.2rem, 2.6vw, 3rem);
    height: calc(100svh - 58px);
    min-height: 32rem;
    padding: clamp(0.8rem, 2vw, 1.8rem) clamp(1rem, 3vw, 2.4rem) clamp(1rem, 2.4vw, 2rem);
  }
  .cover-photo {
    grid-area: photo;
    height: 100%;
    min-height: 0;
  }
  .spine {
    grid-area: spine;
  }
  .toc {
    grid-area: toc;
  }
  .cover-photo a,
  .cover-photo picture {
    display: block;
    height: 100%;
  }
  .cover-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.35s;
  }
  .cover-photo a:hover img {
    opacity: 0.88;
  }
  .cover-photo figcaption {
    position: absolute;
    left: 0;
    bottom: -1.9rem;
    font-size: 0.82rem;
    color: var(--pencil);
  }

  /* 縦組みの帯。flexの column は縦組みでは「右→左」に並ぶ: 右端にコピー、左端に署名 */
  .spine {
    writing-mode: vertical-rl;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.2rem;
    min-height: 0;
  }
  .cover-copy {
    font-family: 'Shippori Mincho', serif;
    font-size: clamp(1.1rem, 0.8rem + 0.7vw, 1.5rem);
    font-weight: 500;
    line-height: 1.95;
    letter-spacing: 0.1em;
  }
  .cover-title {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-self: flex-end;
    gap: 0.45rem;
    font-weight: 400;
    font-feature-settings: normal;
  }
  .t-name {
    font-family: var(--font-en);
    font-size: 1.1rem;
    letter-spacing: 0.04em;
  }
  .t-kana,
  .t-role {
    font-family: 'Shippori Mincho', serif;
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    color: var(--pencil);
  }

  /* 目次: 帯の左に、下端をそろえて置く */
  .toc {
    align-self: end;
    padding-bottom: 0.2rem;
  }
  .toc-ttl {
    font-family: 'Shippori Mincho', serif;
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--pencil);
    margin-bottom: 1rem;
  }
  .toc ol {
    list-style: none;
  }
  .toc a {
    display: grid;
    grid-template-columns: 1.8rem 1fr auto;
    align-items: baseline;
    column-gap: 0.6rem;
    padding: 0.42rem 0;
  }
  .toc li.last {
    margin-top: 1rem;
  }
  .toc-n {
    font-family: 'Shippori Mincho', serif;
    font-size: 0.85rem;
    color: var(--pencil);
  }
  .toc-t {
    font-family: 'Shippori Mincho', serif;
    font-size: clamp(1rem, 0.9rem + 0.3vw, 1.15rem);
    font-feature-settings: 'palt';
  }
  .toc a:hover .toc-t {
    text-decoration: underline 1px;
    text-underline-offset: 0.35em;
  }
  .toc-c {
    font-size: 0.82rem;
    color: var(--pencil);
    font-variant-numeric: tabular-nums;
  }
  .toc li.last .toc-c {
    color: var(--shu);
  }

  /* ===== 中くらいの画面: 目次を写真の下へ ===== */
  @media (max-width: 1080px) {
    .cover {
      grid-template-columns: auto auto minmax(0, 1fr);
      grid-template-rows: auto auto;
      grid-template-areas: 'photo spine .' 'toc toc toc';
      row-gap: 3rem;
      height: auto;
      min-height: calc(100svh - 58px);
    }
    .cover-photo {
      height: 64svh;
    }
    .toc ol {
      columns: 2;
      column-gap: 3rem;
    }
    .toc li {
      break-inside: avoid;
    }
    .toc li.last {
      margin-top: 0;
    }
  }

  /* ===== スマホ: 写真＋縦組みのコピー → 署名 → 目次 ===== */
  @media (max-width: 640px) {
    /* 写真の幅 = 画面幅からコピーの列(5.4rem)を引いた残り。高さは比率から出す(コピーと重ねない) */
    .cover {
      grid-template-columns: minmax(0, 1fr) 5.4rem;
      grid-template-rows: auto;
      grid-template-areas: 'photo copy' 'title title' 'toc toc';
      column-gap: 0.8rem;
      row-gap: 1.6rem;
      padding-bottom: 2rem;
    }
    .cover-photo {
      width: 100%;
      height: auto;
    }
    .cover-copy {
      justify-self: end;
    }
    .spine {
      display: contents;
    }
    .cover-copy {
      grid-area: copy;
      font-size: 1rem;
      letter-spacing: 0.06em;
    }
    .cover-title {
      grid-area: title;
      writing-mode: horizontal-tb;
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: flex-start;
      align-items: baseline;
      align-self: start;
      gap: 0.3rem 0.9rem;
    }
    .toc ol {
      columns: 1;
    }
    .toc li.last {
      margin-top: 0.8rem;
    }
  }
</style>
