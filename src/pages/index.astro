---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { availability } from '../data/profile';
import { events } from '../data/events';
import { webpSrcset, imgSize } from '../lib/img';
import { chapters } from '../data/chapters';

// HOME = 写真集の「表紙と目次」だけ。1画面で完結させ、中身は各章(各ページ)に任せる。
// 下へ長く読ませる抜粋(口絵・仕事・イベント・受賞)は置かない。
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const photos = (await getCollection('photos')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const works = await getCollection('works');
const publicWorks = works.filter((w) => !w.id.startsWith('minima-'));

type Photo = (typeof photos)[number];
const ar = (p: Photo) => p.data.aspect ?? 0.75;
// 題から「第4回YMフォトコン優秀賞‗『いつか』」のような前置きを外して、作品名だけを出す
const titleOf = (p: Photo) => p.data.title.match(/『(.+?)』/)?.[1] ?? p.data.title;

// 表紙: 黒地にネオンの線が走る明暗差の強い横長の1枚。消えていたら最新の横長写真へ
// (作品撮り 05 は画像自体に黒帯が焼き込まれているので表紙には使わない)
const cover =
  photos.find((p) => p.data.thumb.includes('g-event-b82c99a9')) ??
  photos.find((p) => ar(p) > 1.3) ??
  photos[0];

// 目次: 章立ては chapters.ts が正。件数はデータから数える
const tocCount: Record<string, string | undefined> = {
  '/gallery/': `${photos.length}点`,
  '/works/': `${publicWorks.length}件`,
  '/events/': `${events.length}件`,
  '/contact/': availability.open ? availability.short : undefined,
};
const toc = chapters.filter((c) => c.path !== '/');
---

<Base>
  <main class="cover">
    <figure class="cover-photo">
      <a href={`${base}/gallery/`}>
        <picture>
          {webpSrcset(cover.data.thumb, base) && (
            <source
              type="image/webp"
              srcset={webpSrcset(cover.data.thumb, base)}
              sizes="(max-width: 760px) 100vw, 64vw"
            />
          )}
          <img
            src={`${base}${cover.data.thumb}`}
            alt={cover.data.title}
            {...imgSize(cover.data.thumb)}
            fetchpriority="high"
          />
        </picture>
      </a>
      <figcaption>{titleOf(cover)}　{cover.data.date.getFullYear()}</figcaption>
    </figure>

    <div class="spine">
      <p class="cover-copy">
        バーチャルの中に存在する<br />文化や感情を、写真と言葉で<br />外の世界へ運ぶ。
      </p>
      {/* h1に読み仮名と和文の肩書きを持たせる(指名検索・職種検索の受け皿) */}
      <h1 class="cover-title">
        <span class="t-name">YutanpopoZzz</span>
        <span class="t-kana">ゆたんぽぽ</span>
        <span class="t-role">バーチャルフォトグラファー</span>
      </h1>
    </div>

    <nav class="toc" aria-label="このサイトの目次">
      <h2 class="toc-ttl">目次</h2>
      <ol>
        {toc.map((c) => (
          <li class:list={[{ last: c.path === '/contact/' }]}>
            <a href={`${base}${c.path}`}>
              <span class="toc-n">{c.n}</span>
              <span class="toc-t">{c.jp}</span>
              <span class="toc-c">{tocCount[c.path] ?? ''}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </main>
</Base>

<style>
  /* トップは1画面で完結させるので、巻末はここでは出さない(全ページ共通の巻末は各章にある) */
  :global(.site-footer) {
    display: none;
  }

  /* ===== 表紙＋目次: 写真 / 縦組みの帯 / 目次 の3列 ===== */
  .cover {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto clamp(15rem, 20vw, 19rem);
    gap: clamp(1.2rem, 2.6vw, 3rem);
    height: calc(100svh - 58px);
    min-height: 32rem;
    padding: clamp(0.8rem, 2vw, 1.8rem) clamp(1rem, 3vw, 2.4rem) 2.8rem;
  }
  .cover-photo {
    position: relative;
    min-height: 0;
  }
  .cover-photo a,
  .cover-photo picture {
    display: block;
    height: 100%;
  }
  .cover-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.35s;
  }
  .cover-photo a:hover img {
    opacity: 0.88;
  }
  .cover-photo figcaption {
    position: absolute;
    left: 0;
    bottom: -1.9rem;
    font-size: 0.82rem;
    color: var(--pencil);
  }

  /* 縦組みの帯。flexの column は縦組みでは「右→左」に並ぶ: 右端にコピー、左端に署名 */
  .spine {
    writing-mode: vertical-rl;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.2rem;
    min-height: 0;
  }
  .cover-copy {
    font-family: 'Shippori Mincho', serif;
    font-size: clamp(1.1rem, 0.8rem + 0.7vw, 1.5rem);
    font-weight: 500;
    line-height: 1.95;
    letter-spacing: 0.1em;
  }
  .cover-title {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-self: flex-end;
    gap: 0.45rem;
    font-weight: 400;
    font-feature-settings: normal;
  }
  .t-name {
    font-family: var(--font-en);
    font-size: 1.1rem;
    letter-spacing: 0.04em;
  }
  .t-kana,
  .t-role {
    font-family: 'Shippori Mincho', serif;
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    color: var(--pencil);
  }

  /* 目次: 帯の左に、下端をそろえて置く */
  .toc {
    align-self: end;
    padding-bottom: 0.2rem;
  }
  .toc-ttl {
    font-family: 'Shippori Mincho', serif;
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--pencil);
    margin-bottom: 1rem;
  }
  .toc ol {
    list-style: none;
  }
  .toc a {
    display: grid;
    grid-template-columns: 1.8rem 1fr auto;
    align-items: baseline;
    column-gap: 0.6rem;
    padding: 0.42rem 0;
  }
  .toc li.last {
    margin-top: 1rem;
  }
  .toc-n {
    font-family: 'Shippori Mincho', serif;
    font-size: 0.85rem;
    color: var(--pencil);
  }
  .toc-t {
    font-family: 'Shippori Mincho', serif;
    font-size: clamp(1rem, 0.9rem + 0.3vw, 1.15rem);
    font-feature-settings: 'palt';
  }
  .toc a:hover .toc-t {
    text-decoration: underline 1px;
    text-underline-offset: 0.35em;
  }
  .toc-c {
    font-size: 0.82rem;
    color: var(--pencil);
    font-variant-numeric: tabular-nums;
  }
  .toc li.last .toc-c {
    color: var(--shu);
  }

  /* ===== 中くらいの画面: 目次を写真の下へ ===== */
  @media (max-width: 1080px) {
    .cover {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-rows: minmax(0, 1fr) auto;
      grid-template-areas: 'photo spine' 'toc spine';
      row-gap: 3rem;
      height: auto;
      min-height: calc(100svh - 58px);
    }
    .cover-photo {
      grid-area: photo;
      height: 58svh;
    }
    .spine {
      grid-area: spine;
    }
    .toc {
      grid-area: toc;
    }
    .toc ol {
      columns: 2;
      column-gap: 3rem;
    }
    .toc li {
      break-inside: avoid;
    }
    .toc li.last {
      margin-top: 0;
    }
  }

  /* ===== スマホ: 写真＋縦組みのコピー → 署名 → 目次 ===== */
  @media (max-width: 640px) {
    .cover {
      grid-template-columns: 1fr 4.2rem;
      grid-template-areas: 'photo copy' 'title title' 'toc toc';
      row-gap: 1.6rem;
      padding-bottom: 2rem;
    }
    .cover-photo {
      height: 54svh;
    }
    .cover-photo figcaption {
      position: static;
      margin-top: 0.5rem;
    }
    .spine {
      display: contents;
    }
    .cover-copy {
      grid-area: copy;
      font-size: 1rem;
      letter-spacing: 0.06em;
    }
    .cover-title {
      grid-area: title;
      writing-mode: horizontal-tb;
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: flex-start;
      align-items: baseline;
      align-self: start;
      gap: 0.3rem 0.9rem;
    }
    .toc ol {
      columns: 1;
    }
    .toc li.last {
      margin-top: 0.8rem;
    }
  }
</style>
