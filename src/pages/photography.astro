---
import '../styles/book.css';
// 「VRChat 撮影 依頼」「バーチャルフォトグラファー とは」で入ってきた人が
// 最初に着地するページ。答えを先に書き、最後にCONTACTへ渡す。
// 事実はCONTACT・WORKS・ABOUTに書いてあることだけを使う(ここで新しい条件を作らない)。
import AwardPhoto from '../components/AwardPhoto.astro';
import Base from '../layouts/Base.astro';
import { availability, exhibitions, clientWorks } from '../data/profile';
import { services } from '../data/services';
import { faqs } from '../data/faq';
import { orderFlow } from '../data/order-flow';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = Astro.site!.href.replace(/\/$/, '');

// サービスごとの詳しい説明(短い一言は services.ts、ここは依頼者向けの本文)
const detail: Record<string, string> = {
  portrait:
    'キャラクター性を強く引き出すポートレートが得意です。クールでストリートな空気をまとわせながら、一枚から物語が想像できる画面をつくります。バーチャル宣材写真、記念撮影、コンセプトフォトなど。イメージに合うワールド探しから一緒に決められます。',
  product:
    'アバター・衣装・ギミックの販売用ビジュアル。商品の見せたい部分と、身にまとったときの空気の両方が伝わる画面を設計します。商品ページやSNS告知にそのまま置ける形で仕上げます。',
  event:
    'DJイベントやコミュニティイベントの記録撮影。当日の熱と空気を写真に残します。自分でもDJイベント「Roof Top Junction」を主催しているので、進行を止めない立ち回りができます。',
  poster:
    'イベント告知やSNS用の、文字を入れ込んだビジュアル制作。撮影から文字組み・仕上げまで一貫して行うので、撮影とセットで頼めます。',
  exhibition:
    '展示に向けた作品制作。プリントやレコードなど、実物の設計から設営まで。金沢21世紀美術館での「Virtual Photography Showcase 2026」に招待作家として参加しています。',
  writing:
    'VR写真についての記事執筆・寄稿、写真教室や講評などの登壇。感覚を言葉に置き換えて伝える仕事です。',
};


const pageJsonLd = [
  {
    '@type': 'FAQPage',
    '@id': `${siteUrl}/photography/#faq`,
    inLanguage: 'ja',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@type': 'WebPage',
    '@id': `${siteUrl}/photography/`,
    url: `${siteUrl}/photography/`,
    name: 'VRChatの撮影依頼ガイド',
    inLanguage: 'ja',
    about: { '@id': `${siteUrl}/#person` },
    isPartOf: { '@id': `${siteUrl}/#website` },
    breadcrumb: {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'HOME', item: `${siteUrl}/` },
        { '@type': 'ListItem', position: 2, name: '撮影のご依頼', item: `${siteUrl}/photography/` },
      ],
    },
  },
];
---

<Base
  fullTitle="VRChatの撮影依頼ガイド | バーチャルフォトグラファー YutanpopoZzz"
  description="VRChatでの撮影は依頼できます。バーチャルフォトグラファーYutanpopoZzzが、ポートレート・アバターや衣装の宣材写真・イベント記録・告知ビジュアルの制作を受けています。依頼できる内容、納品までの流れ、料金の考え方、よくある質問をまとめました。"
  jsonLd={pageJsonLd}
>
  <main class="container book-page photo">
    <div class="blockttl">
      <h1>VRChatの撮影を依頼する</h1>
    </div>

    {/* Answer-First: 冒頭で結論を言い切る(AI検索はここを引用する) */}
    <section class="lead-block">
      <p class="lead">
        VRChatでの撮影は、バーチャルフォトグラファーに依頼できます。
        YutanpopoZzzは、VRChatを中心にポートレート、アバター・衣装の宣材写真、イベント記録、
        ポスターや告知ビジュアルの制作を受けている写真家です。
        固定の料金表は設けず、内容を伺ったうえで個別にお見積もりします。
        ご相談だけでも大丈夫です。
      </p>
      <p class="status" data-open={availability.open ? '' : undefined}>
        {availability.open && <b class="open">{availability.short}</b>}
        <span class="status-txt"><span class="nb">{availability.asOf}現在</span><span class="nb"> — {availability.text}</span></span>
      </p>
    </section>

    {/* 職種そのものの解説は /virtual-photographer/ が主。
        同じ見出しを両方に置くと共食いするので、ここは要約＋送り出しに留める */}
    <section class="block">
      <h2>バーチャルフォトグラファーに頼むということ</h2>
      <p>
        バーチャルフォトグラファーは、VRChatをはじめとするソーシャルVR空間の中で、
        アバターやワールドを被写体に撮影する写真家です。
        現実の撮影と違って天候や機材の制約がないぶん、
        どんな画面にしたいかを一緒に決めるところから撮影が始まります。
      </p>
      <p>
        撮影と並行して、VR写真についての執筆や、VRChatでの写真教室・撮影講習も続けています。
      </p>
      <p class="more">
        <a href={`${base}/virtual-photographer/`}>バーチャルフォトグラファーとは何かを詳しく読む</a>
      </p>
      <p class="more"><a href={`${base}/about/`}>プロフィールと考えていることを読む</a></p>
    </section>

    <!-- 依頼できる内容 -->
    <section class="block">
      <h2>依頼できる撮影・制作</h2>
      <div class="sv-list">
        {services.map((s) => (
          <article class="sv" id={s.slug}>
            <h3>{s.name}</h3>
            <p>{detail[s.slug] ?? s.desc}</p>
            <p class="sv-more">
              <a href={`${base}/works/tag/${s.slug}/`}>{s.name}の実績を見る</a>
            </p>
          </article>
        ))}
      </div>
    </section>

    <!-- 流れ -->
    <section class="block">
      <h2>依頼から納品までの流れ</h2>
      <ol class="steps">
        {orderFlow.map((s, i) => (
          <li>
            <span class="step-no">{['一', '二', '三', '四', '五'][i]}</span>
            <span class="step-body">
              <b>{s.t}</b>
              <span>{s.d}</span>
            </span>
          </li>
        ))}
      </ol>
    </section>

    <!-- 第三者評価(依頼者が最後に確かめたいところ) -->
    <section class="block">
      <h2>これまでの評価</h2>
      <AwardPhoto size="medium" />
      <table class="awards"><tbody>
        {exhibitions.map((a) => (
          <tr><td class="year">{a.year}</td><td>{a.title}{a.note && <span class="note">（{a.note}）</span>}</td></tr>
        ))}
        {clientWorks.map((a) => (
          <tr><td class="year">{a.year}</td><td>{a.title}{a.note && <span class="note">（{a.note}）</span>}</td></tr>
        ))}
      </tbody></table>
      <p class="more"><a href={`${base}/about/`}>受賞・クライアントワークの全量</a></p>
    </section>

    <!-- FAQ -->
    <section class="block" id="faq">
      <h2>よくある質問</h2>
      <dl class="faq">
        {faqs.map((f) => (
          <div class="qa">
            <dt>{f.q}</dt>
            <dd>{f.a}</dd>
          </div>
        ))}
      </dl>
    </section>

    <a class="cta" href={`${base}/contact/`}>
      <span style="display:inline-block">撮影・ビジュアル制作のご依頼、</span><span style="display:inline-block">ご相談だけでも歓迎です</span>
    </a>
  </main>
</Base>


<style>
.photo { max-width: 840px; }
  .lead { line-height: 2; }
  .sv-list { margin-top: 2.4rem; }
  .sv + .sv { margin-top: 3rem; }
  .sv p { margin-top: 0.7rem; }
  .sv-more { font-size: 0.88rem; color: var(--pencil); }
  .steps { list-style: none; }
  .steps li { display: flex; gap: 1.5rem; margin-top: 2.4rem; }
  .step-no { flex: none; font-family: 'Shippori Mincho', serif; font-size: 0.85rem; color: var(--pencil); padding-top: 0.25rem; }
  .step-body b { display: block; font-family: 'Shippori Mincho', serif; font-size: 1.15rem; font-weight: 500; }
  .step-body > span { display: block; margin-top: 0.5rem; max-width: 38em; }
</style>
