---
import '../styles/book.css';
import '../styles/lightbox.css';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PhotoCard from '../components/PhotoCard.astro';
import { photoAspect } from '../lib/photo-aspect';
import PhotoMasonry from '../components/PhotoMasonry.astro';

const photos = (await getCollection('photos')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const featured = photos.find((p) => p.data.featured) ?? photos[0];
const featuredAspect = featured ? featured.data.aspect ?? await photoAspect(featured.data.thumb) : 1;
const masonryPhotos = photos.filter((p) => p !== featured);
const cats = [
  { key: 'all', label: 'すべて' },
  { key: 'portrait', label: 'ポートレート' },
  { key: 'commercial', label: '宣材・商品' },
  { key: 'event', label: 'イベント' },
  { key: 'photocontest', label: 'フォトコンテスト' },
];
---

<Base
  fullTitle="作品ギャラリー | バーチャルフォトグラファー YutanpopoZzz"
  description="バーチャルフォトグラファー YutanpopoZzz のVR写真ギャラリー。VRChatで撮影したポートレート、アバター・衣装の商品撮影、イベント記録、フォトコンテスト出品作を分類して掲載しています。"
>
  <main class="container book-page">
    <div class="blockttl">
      <h1>ギャラリー</h1>
    </div>

    {featured && (
      <div class:list={['gallery-feature', { portrait: featuredAspect < 1 }]} data-featured data-category={featured.data.category}>
        <PhotoCard photo={featured} aspect={featuredAspect} sizes="(max-width: 1180px) 94vw, 1104px" titleOnly />
      </div>
    )}

    <div class="filter" role="tablist" aria-label="カテゴリで絞り込み">
      {cats.map((c, i) => (
        <button class:list={['filter-btn', { active: i === 0 }]} data-filter={c.key}>
          {c.label}
        </button>
      ))}
    </div>

    <PhotoMasonry photos={masonryPhotos} />
  </main>

  <!-- 写真タップで拡大表示するライトボックス -->
  <div class="lightbox" id="lightbox" hidden>
    <figure>
      <img id="lb-img" src="" alt="" draggable="false" />
      <figcaption>
        <span class="lb-title" id="lb-title"></span>
        <span class="lb-caption" id="lb-caption"></span>
        <span class="lb-note">※ サイト掲載用にリサイズした画像です</span>
      </figcaption>
    </figure>
  </div>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const grid = document.querySelector<HTMLElement>('[data-masonry]');
  const featured = document.querySelector<HTMLElement>('[data-featured]');
  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => b.classList.toggle('active', b === btn));
      if (featured) featured.hidden = btn.dataset.filter !== 'all' && btn.dataset.filter !== featured.dataset.category;
      grid?.dispatchEvent(
        new CustomEvent('masonry:filter', { detail: btn.dataset.filter })
      );
    });
  });

  // ライトボックス: 写真タップで拡大、もう一度タップ/Escで閉じる
  const lightbox = document.getElementById('lightbox')!;
  const lbImg = document.getElementById('lb-img') as HTMLImageElement;
  const lbTitle = document.getElementById('lb-title')!;
  const lbCaption = document.getElementById('lb-caption')!;

  document.querySelector('main')?.addEventListener('click', (e) => {
    const card = (e.target as HTMLElement).closest<HTMLElement>('.photo-card');
    if (!card) return;
    const img = card.querySelector('img');
    if (!img) return;
    // 拡大時だけ原寸(WebP)を読む。グリッドのimgは小さい変種なのでそのままでは粗い
    lbImg.src = card.dataset.full || img.currentSrc || img.src;
    lbImg.alt = card.dataset.title ?? '';
    lbTitle.textContent = card.dataset.title ?? '';
    lbCaption.textContent = card.dataset.caption ?? '';
    lightbox.hidden = false;
    document.body.style.overflow = 'hidden';
  });

  // 等倍だと拡大が強すぎたので原寸の半分まで。
  // ただし元が小さい画像だと拡大したことにならないので、最低1.5倍は効かせる
  const ZOOM_SCALE = 0.5;
  const MIN_ZOOM = 1.5;

  const unzoom = () => {
    lightbox.classList.remove('zoomed');
    lbImg.style.width = '';
    lightbox.scrollTo(0, 0);
  };

  const closeLightbox = () => {
    lightbox.hidden = true;
    unzoom();
    lbImg.src = '';
    document.body.style.overflow = '';
  };

  // 写真をタップ: ズームin/out。写真の外をタップ: 閉じる
  lbImg.addEventListener('click', (e) => {
    e.stopPropagation();
    if (lightbox.classList.contains('zoomed')) {
      unzoom();
    } else {
      // クリックした位置を中心に拡大する
      const r = lbImg.getBoundingClientRect();
      const rx = (e.clientX - r.left) / r.width;
      const ry = (e.clientY - r.top) / r.height;
      const iw = Math.min(
        lbImg.naturalWidth,
        Math.max(lbImg.naturalWidth * ZOOM_SCALE, r.width * MIN_ZOOM)
      );
      const ih = iw * (lbImg.naturalHeight / lbImg.naturalWidth);
      lbImg.style.width = `${iw}px`;
      lightbox.classList.add('zoomed');
      lightbox.scrollTo(
        iw * rx - lightbox.clientWidth / 2,
        ih * ry - lightbox.clientHeight / 2
      );
    }
  });
  lightbox.addEventListener('click', closeLightbox);
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !lightbox.hidden) closeLightbox();
  });
</script>


<style>
  .gallery-feature { margin-bottom: 5rem; }
  .gallery-feature :global(.photo-card) { margin: 0; }
  .gallery-feature :global(figcaption) { font-size: 0.82rem; }
  .gallery-feature :global(.ttl) { display: block; margin-bottom: 0.2rem; font-size: 1rem; }
  .gallery-feature.portrait :global(.photo-card) { display: flex; align-items: flex-end; gap: 2.4rem; }
  .gallery-feature.portrait :global(.frame) { flex: 0 1 auto; min-width: 0; }
  .gallery-feature.portrait :global(.frame img) { width: auto; height: min(86svh, 56rem); max-width: 100%; object-fit: contain; object-position: left bottom; }
  .gallery-feature.portrait :global(figcaption) { flex: 1; min-width: 10rem; }
  @media (max-width: 760px) {
    .gallery-feature.portrait :global(.photo-card) { display: block; }
    .gallery-feature.portrait :global(.frame img) { width: 100%; height: auto; }
  }

.filter { display: flex; flex-wrap: wrap; gap: 0.8rem 1.8rem; margin: 0 0 3rem; }
  .filter-btn { all: unset; font-family: var(--font-jp); font-size: 0.9rem; color: var(--pencil); cursor: pointer; }
  .filter-btn:hover { color: var(--ink); }
  .filter-btn.active { color: var(--ink); text-decoration: underline 1px var(--pencil); text-underline-offset: 0.35em; }
  .filter-btn:focus-visible { outline: 1px solid var(--ink); outline-offset: 4px; }
  :global(.photo-card) { cursor: zoom-in; }
</style>
