---
import '../styles/book.css';
import Base from '../layouts/Base.astro';
import EventLinks from '../components/EventLinks.astro';
import { events, scaleNote } from '../data/events';
import { webpSrcset } from '../lib/img';

const EV_SIZES = '(max-width: 1180px) 94vw, 1104px';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const groups = [
  { key: 'HOSTED', jp: '主催イベント', items: events.filter((e) => e.status === 'host') },
  { key: 'ORGANIZING', jp: '運営参加イベント', items: events.filter((e) => e.status === 'organizer') },
  { key: 'STAFF', jp: 'スタッフ参加イベント', items: events.filter((e) => e.status === 'staff') },
  { key: 'PAST', jp: '過去携わったイベント', items: events.filter((e) => e.status === 'past') },
].filter((g) => g.items.length > 0);
const supporting = groups.flatMap((g) => g.items).filter((ev) => ev.status !== 'host');
---

<Base
  title="EVENTS"
  description="VRChat内でのイベント運営 — DJイベントRoof Top Junction主催ほか、企画・広報・会場運営の実績"
>
  <main class="container book-page events">
    <div class="blockttl">
      <h1>イベント運営</h1>
    </div>
    <p class="lead">撮影やビジュアル制作のほかに、VRChat内のイベント運営にも携わっています。主催・企画から広報、会場運営まで——「場をつくる」側の仕事の記録です。</p>
    <p class="scale-note">※ {scaleNote}</p>

    {groups.map((g) => (
      <section class="group">
        <h3>{g.jp}</h3>
        {g.items.map((ev) => (
          <article class:list={['event', { supporting: ev.status !== 'host', 'has-image': !!ev.image, reverse: supporting.indexOf(ev) % 2 === 1 }]}>
            <div class="event-copy">
            <header>
              <h4 lang={/^[\x00-\x7F]+$/.test(ev.name) ? 'en' : 'ja'}>
                {ev.page ? (
                  <a href={`${base}${ev.page}`}>{ev.name}</a>
                ) : (
                  ev.name
                )}
              </h4>
              <span class="genre">{ev.genre}</span>
            </header>
            {ev.status === 'host' && ev.image && (
              <div class:list={['img-frame', { linked: !!ev.page }]}>
                {ev.page ? (
                  <a href={`${base}${ev.page}`} aria-label={`${ev.name} の紹介ページへ`}>
                    <picture>
                      {webpSrcset(ev.image, base) && (
                        <source type="image/webp" srcset={webpSrcset(ev.image, base)} sizes={EV_SIZES} />
                      )}
                      <img
                        src={`${base}${ev.image}`}
                        alt={`${ev.name} キービジュアル`}
                        loading="lazy"
                        decoding="async"
                      />
                    </picture>
                  </a>
                ) : (
                  <picture>
                    {webpSrcset(ev.image, base) && (
                      <source type="image/webp" srcset={webpSrcset(ev.image, base)} sizes={EV_SIZES} />
                    )}
                    <img
                      src={`${base}${ev.image}`}
                      alt={`${ev.name} キービジュアル`}
                      loading="lazy"
                      decoding="async"
                    />
                  </picture>
                )}
              </div>
            )}

            {ev.summary.map((p) => <p class="summary">{p}</p>)}

            {ev.status === 'host' ? (
            <dl class="meta">
              <div>
                <dt>主な役割</dt>
                <dd>{ev.roles}</dd>
              </div>
              <div>
                <dt>担当業務</dt>
                <dd>{ev.tasks}</dd>
              </div>
              <div>
                <dt>イベント規模</dt>
                <dd>{ev.scale.join(' ／ ')}</dd>
              </div>
              {ev.related && (
                <div>
                  <dt>関連イベント</dt>
                  <dd>
                    <ul class="related">
                      {ev.related.map((r) => (
                        <li>
                          {r.name} — {r.scale}
                          {r.links?.map((l) => (
                            <a class="rel-link" href={l.url} target="_blank" rel="noopener noreferrer">{l.label}</a>
                          ))}
                        </li>
                      ))}
                    </ul>
                  </dd>
                </div>
              )}
            </dl>
            ) : (
              <details class="fold">
                <summary>役割と規模を見る</summary>
            <dl class="meta">
              <div>
                <dt>主な役割</dt>
                <dd>{ev.roles}</dd>
              </div>
              <div>
                <dt>担当業務</dt>
                <dd>{ev.tasks}</dd>
              </div>
              <div>
                <dt>イベント規模</dt>
                <dd>{ev.scale.join(' ／ ')}</dd>
              </div>
              {ev.related && (
                <div>
                  <dt>関連イベント</dt>
                  <dd>
                    <ul class="related">
                      {ev.related.map((r) => (
                        <li>
                          {r.name} — {r.scale}
                          {r.links?.map((l) => (
                            <a class="rel-link" href={l.url} target="_blank" rel="noopener noreferrer">{l.label}</a>
                          ))}
                        </li>
                      ))}
                    </ul>
                  </dd>
                </div>
              )}
            </dl>
              </details>
            )}

            {(ev.links.length > 0 || ev.credits) && (
              <div class="foot">
                <EventLinks links={ev.links} />
                {ev.credits && (
                  <div class="credits">
                    {ev.credits.map((c) => (
                      <span>
                        {c.role} :{' '}
                        {c.url ? (
                          <a href={c.url} target="_blank" rel="noopener noreferrer">{c.name}</a>
                        ) : (
                          c.name
                        )}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            )}
            </div>
            {ev.status !== 'host' && ev.image && (
              <div class:list={['img-frame', { linked: !!ev.page }]}>
                {ev.page ? (
                  <a href={`${base}${ev.page}`} aria-label={`${ev.name} の紹介ページへ`}>
                    <picture>
                      {webpSrcset(ev.image, base) && (
                        <source type="image/webp" srcset={webpSrcset(ev.image, base)} sizes="(max-width: 760px) 66vw, 352px" />
                      )}
                      <img
                        src={`${base}${ev.image}`}
                        alt={`${ev.name} キービジュアル`}
                        loading="lazy"
                        decoding="async"
                      />
                    </picture>
                  </a>
                ) : (
                  <picture>
                    {webpSrcset(ev.image, base) && (
                      <source type="image/webp" srcset={webpSrcset(ev.image, base)} sizes="(max-width: 760px) 66vw, 352px" />
                    )}
                    <img
                      src={`${base}${ev.image}`}
                      alt={`${ev.name} キービジュアル`}
                      loading="lazy"
                      decoding="async"
                    />
                  </picture>
                )}
              </div>
            )}

          </article>
        ))}
      </section>
    ))}
  </main>
</Base>


<style>
  .supporting.has-image { display: grid; grid-template-columns: 22rem minmax(0, 1fr); gap: 3rem; align-items: start; }
  .supporting.has-image .img-frame { grid-column: 1; grid-row: 1; }
  .supporting.has-image .event-copy { grid-column: 2; grid-row: 1; min-width: 0; }
  .supporting.has-image.reverse { grid-template-columns: minmax(0, 1fr) 22rem; }
  .supporting.has-image.reverse .img-frame { grid-column: 2; }
  .supporting.has-image.reverse .event-copy { grid-column: 1; }
  .event.supporting h4 { font-size: clamp(1.4rem, 1.2rem + 0.6vw, 1.8rem); }
  .events .group:nth-of-type(3) { margin-top: 11rem; }
  .events .group:nth-of-type(4) { margin-top: 7rem; }
  .event.supporting + .event.supporting { margin-top: 8rem; }
  @media (max-width: 760px) {
    .supporting.has-image, .supporting.has-image.reverse { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
    .supporting.has-image .img-frame, .supporting.has-image.reverse .img-frame { grid-column: 1; grid-row: 1; width: 70%; margin-bottom: 0; }
    .supporting.has-image .event-copy, .supporting.has-image.reverse .event-copy { grid-column: 1; grid-row: 2; }
  }

.genre { display: block; color: var(--pencil); font-size: 0.85rem; margin-top: 0.5rem; }
  .meta { max-width: 48rem; margin-top: 2rem; }
  .meta > div { display: grid; grid-template-columns: 7em minmax(0, 1fr); gap: 1.4rem; padding: 0.5rem 0; }
  .meta dt { color: var(--pencil); font-size: 0.88rem; }
  .meta dd { max-width: 38em; }
  .scale-note { display: block; color: var(--pencil); font-size: 0.82rem; margin-top: 0.7rem; }
  .foot { margin-top: 2.4rem; }
  .credits { display: flex; flex-wrap: wrap; gap: 0.6rem 1.5rem; color: var(--pencil); font-size: 0.82rem; margin-top: 1.2rem; }
  @media (max-width: 560px) { .meta > div { grid-template-columns: 1fr; gap: 0.2rem; } }

  .lead { margin-bottom: 1rem; }
  .group { margin-top: 10rem; }
  .group:nth-of-type(2n) { margin-top: 8rem; }
  .event + .event { margin-top: 6rem; }
  .event h4 { font-size: clamp(1.8rem, 1.4rem + 1.8vw, 3rem); line-height: 1.25; }
  .event h4:lang(en) { font-family: var(--font-en); }
  .event header { margin-bottom: 1.6rem; }
  .img-frame { margin-bottom: 2rem; }
  .img-frame img { width: 100%; height: auto; transition: opacity 0.25s; }
  .img-frame a:hover img { opacity: 0.86; }
  .summary { margin: 1.2rem 0; }
  .related { list-style: none; }
  .related li + li { margin-top: 0.7rem; }
  .rel-link { display: inline-block; margin-left: 0.8rem; color: var(--pencil); font-size: 0.85rem; }
</style>
