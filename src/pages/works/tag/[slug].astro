---
import '../../../styles/book.css';
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import WorkCard from '../../../components/WorkCard.astro';
import Crumbs from '../../../components/Crumbs.astro';
import BackFab from '../../../components/BackFab.astro';
import { services } from '../../../data/services';

export async function getStaticPaths() {
  const works = (await getCollection('works')).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime()
  );
  return services.map((service) => ({
    params: { slug: service.slug },
    props: {
      service,
      items: works.filter((w) => w.data.category === service.name),
    },
  }));
}

const { service, items } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base
  fullTitle={`${service.name}の実績 | バーチャルフォトグラファー YutanpopoZzz`}
  description={`VRChatでの${service.name}の実績。${service.desc}。バーチャルフォトグラファー YutanpopoZzz が承っています。`}
>
  <main class="container book-page tagpage">
    <Crumbs
      items={[
        { label: 'ポートフォリオ', href: `${base}/works/` },
        { label: service.name },
      ]}
    />

    <div class="blockttl">
      <h1>{service.name}</h1>
    </div>
    <p class="lead">{service.desc}</p>

    {items.length > 0 ? (
      <div class="grid">
        {items.map((w) => <WorkCard work={w} />)}
      </div>
    ) : (
      <p class="empty">この分野の実績ページを準備中です。順次追加していきます。</p>
    )}

    <nav class="other-tags" aria-label="ほかのしごと">
      <span class="ot-label">ほかのしごと</span>
      {services
        .filter((s) => s.slug !== service.slug)
        .map((s) => (
          <a href={`${base}/works/tag/${s.slug}/`}>{s.name}
          </a>
        ))}
    </nav>

    <p class="back"><a href={`${base}/works/`}>ポートフォリオ一覧にもどる</a></p>
  </main>

  <BackFab href={`${base}/works/`} label="ポートフォリオ" />
</Base>


<style>
.lead { color: var(--pencil); margin-bottom: 3rem; }
  .other-tags { display: flex; flex-wrap: wrap; align-items: baseline; gap: 1rem 2rem; margin-top: 8rem; }
  .ot-label { flex-basis: 100%; color: var(--pencil); font-size: 0.85rem; }
</style>
