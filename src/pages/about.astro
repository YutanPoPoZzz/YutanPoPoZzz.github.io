---
import '../styles/book.css';
import Base from '../layouts/Base.astro';
import { awards, clientWorks, sponsors, exhibitions, activities } from '../data/profile';
import { webpSrcset } from '../lib/img';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const sections = [
  { key: 'AWARDS', jp: '受賞', items: awards },
  { key: 'CLIENT WORKS', jp: 'クライアントワーク', items: clientWorks },
  { key: 'SPONSOR', jp: 'スポンサー', items: sponsors },
  { key: 'EXHIBITIONS', jp: '展示・掲載', items: exhibitions },
  { key: 'PROJECTS', jp: '企画・活動', items: activities },
];

// タイトル末尾の賞グレードをバッジとして分離する(該当なしはそのまま)
const splitGrade = (t: string) => {
  const m = t.match(/^(.*?)\s*(最優秀賞|優秀賞|入賞|審査員賞)$/);
  return m ? { base: m[1], grade: m[2] } : { base: t, grade: null };
};

// 指名検索の受け皿: このページが「YutanpopoZzz(ゆたんぽぽ)本人のプロフィール」だと明示する
const siteUrl = Astro.site!.href.replace(/\/$/, '');
const pageJsonLd = [
  {
    '@type': 'ProfilePage',
    '@id': `${siteUrl}/about/`,
    url: `${siteUrl}/about/`,
    name: 'YutanpopoZzz（ゆたんぽぽ）のプロフィール',
    inLanguage: 'ja',
    mainEntity: { '@id': `${siteUrl}/#person` },
    isPartOf: { '@id': `${siteUrl}/#website` },
  },
];
---

<Base
  fullTitle="プロフィール・受賞歴 | バーチャルフォトグラファー YutanpopoZzz（ゆたんぽぽ）"
  description="YutanpopoZzz（ゆたんぽぽ）のプロフィール。VRChatを中心に活動するバーチャルフォトグラファーで、ポートレート・商品・イベントの撮影とビジュアル制作を行っています。VR Photography Contest 2025 最優秀賞、VR PHOTO COMPETITION 2025 優秀賞ほか、受賞歴・クライアントワーク・展示の実績。"
  jsonLd={pageJsonLd}
>
  <main class="container book-page about">
    <div class="blockttl">
      <h1>じぶんのこと</h1>
    </div>
    <div class="body-wrap">
    <div class="body">
      <p class="name-line"><strong>YutanpopoZzz</strong><span class="reading">ゆたんぽぽ</span><span class="role">Virtual Photographer / Visual Creator</span></p>
      <p>VRChatを中心に、ポートレートや商品・イベントのプロモーション撮影、ビジュアル制作を行っています。得意なのは、キャラクター性を強く引き出すポートレート。クールでストリートな空気をまとわせながら、一枚から物語が想像できる画面をつくります。その持ち味を活かして、ポスターや告知ビジュアルの制作も手がけています。</p>
      <h2 class="scene-title">なぜVRで撮るのか</h2>
      <p>ここには重力や天候といった現実の制約がなく、構図・光・キャラクターと、どこまでも純粋に向き合えるからです。そしてVRChatは、会話だけでなく「空間を共有する」SNSでもあります。同じ場所に立つことで生まれる風景や関係性には、現実を超えた魅力がある——ここにしか写せない本質があると、私は考えています。</p>
      <p>ただ、その魅力はまだ外の世界からは見えにくいままです。だから、写真で残して、伝える。同じ思いで、VRChatについての文章の執筆や、写真文化を広げるための撮影講習も続けています。</p>
      <ul class="sns">
        <li><a href="https://vrchat.com/home/user/usr_029b3b9d-63fc-4557-97d4-68cc176922ed" target="_blank" rel="noopener noreferrer">VRChat</a></li>
        <li><a href="https://x.com/YutanpopoZzz" target="_blank" rel="noopener noreferrer">X</a></li>
        <li><a href={`${base}/works/`}>WORKS</a></li>
      </ul>
    </div>
    <figure class="me">
      <picture>
        {webpSrcset('/about/portrait.jpg', base) && (
          <source
            type="image/webp"
            srcset={webpSrcset('/about/portrait.jpg', base)}
            sizes="(max-width: 760px) 78vw, 480px"
          />
        )}
        <img
          src={`${base}/about/portrait.jpg`}
          alt="YutanpopoZzz のポートレート"
          width="1200"
          height="1600"
          loading="lazy"
          decoding="async"
        />
      </picture>
    </figure>
    </div>

    <div class="blockttl">
      <h2>実績</h2>
    </div>
    <div class="achievements">
    {sections.map((s) => (
      <section class:list={["ach", { "ach-awards": s.key === "AWARDS" }]}>
        <h3>{s.jp}</h3>
        <table class="awards"><tbody>
          {s.items.map((a) => {
            const g = splitGrade(a.title);
            return (
              <tr>
                <td class="year">{a.year}</td>
                <td class="ttl">
                  {a.href ? <a href={`${base}${a.href}`}>{g.base}</a> : g.base}
                {g.grade && (
                  <span class="grade">{g.grade}</span>
                )}
                {a.note && <span class="note">{a.note}</span>}
                </td>
              </tr>
            );
          })}
        </tbody></table>
      </section>
    ))}
    </div>
    <p class="events-link"><a href={`${base}/events/`}>イベント運営の実績をくわしく見る</a></p>
    <p class="dj-link"><a href={`${base}/dj/`}>DJとして主催・出演したイベントの一覧</a></p>
    <p class="disclaimer">※ 実績の詳細名・クライアント名は順次追記します</p>
  </main>
</Base>


<style>
.body-wrap { display: grid; grid-template-columns: 5fr 6fr; gap: clamp(2rem, 5vw, 4.4rem); align-items: start; }
  .me { order: -1; }
  .me img { width: 100%; height: auto; }
  .body { min-width: 0; }
  .body p { margin: 0 0 1.5rem; }
  .name-line { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.3rem 1rem; }
  .name-line strong { font-family: var(--font-en); font-weight: 500; font-size: 1.6rem; }
  .reading { color: var(--pencil); font-size: 0.85rem; }
  .role { flex-basis: 100%; font-family: var(--font-en); color: var(--pencil); font-size: 1rem; }
  .sns { list-style: none; display: flex; flex-wrap: wrap; gap: 1rem 2rem; margin-top: 2rem; }
  .body-wrap + .blockttl { margin-top: 10rem; }
  .body .scene-title { margin-top: 5rem; }
  .achievements { display: grid; grid-template-columns: minmax(0, 1fr); gap: 6rem clamp(2rem, 5vw, 4.4rem); }
  .ach { min-width: 0; }
  .ach-awards { grid-column: 1 / -1; max-width: 48rem; }
  @media (min-width: 900px) { .achievements { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .events-link { margin-top: 3rem; }
  .dj-link { margin-top: 0.8rem; }
  .disclaimer { margin-top: 1rem; color: var(--pencil); font-size: 0.82rem; }
  @media (max-width: 760px) { .body-wrap { grid-template-columns: 1fr; } .me { width: 85%; max-width: 28rem; } }
</style>
